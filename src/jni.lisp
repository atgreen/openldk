(in-package :openldk)

;;; JNI references are handles, never addresses of Lisp objects. The C shim
;;; forwards the standard ABI into this runtime through one guarded callback.
(defstruct jni-reference object kind environment)
(defstruct jni-member class name descriptor static-p field-p)
(defstruct jni-state (frames (list nil)) pending loader java-thread loading-library scoped-cache monitors)
(defstruct jni-library path loader address (state :loading) owner registrations
  (mutex (bordeaux-threads:make-lock "JNI library initialization"))
  (condition (bordeaux-threads:make-condition-variable)))
(defvar *jni-references* (make-hash-table :synchronized t))
(defvar *jni-members* (make-hash-table :synchronized t))
(defvar *jni-member-ids* (make-hash-table :test #'equal :synchronized t))
(defvar *jni-states* (make-hash-table :synchronized t))
(defvar *jni-bindings* (make-hash-table :test #'equal :synchronized t))
(defvar *jni-libraries* nil)
(defvar *jni-counter* 0)
(defvar *jni-lock* (bordeaux-threads:make-recursive-lock "JNI libraries and handles"))
(defvar *jni-loaded* nil)
(defvar *jni-environment* 0)
(defvar *jni-current-state* nil)
(defparameter *jni-default-shim*
  (namestring (asdf:system-relative-pathname :openldk "libopenldk-jni.so")))

(defmacro %jni-c (name result &rest arguments)
  `(sb-alien:alien-funcall
    (sb-alien:extern-alien ,name (function ,result ,@(mapcar #'first arguments)))
    ,@(mapcar (lambda (argument)
                (if (eql (first argument) 'sb-alien:c-string)
                    `(coerce ,(second argument) 'simple-string)
                    (second argument))) arguments)))

(defun %jni-pointer (integer) (sb-sys:int-sap integer))
(defun %jni-address (pointer) (sb-sys:sap-int pointer))
(defun %jni-u64 (value) (logand value #xffffffffffffffff))
(defun %jni-signed (value bits) (sb-c::mask-signed-field bits value))
(defun %jni-arg (args index) (sb-sys:sap-ref-64 args (* index 8)))
(defun %jni-cstring (address)
  (sb-alien:cast (sb-alien:sap-alien (%jni-pointer address) (* sb-alien:char)) sb-alien:c-string))

(defun %jni-state (environment)
  (or (gethash environment *jni-states*)
      (sb-ext:with-locked-hash-table (*jni-states*)
        (or (gethash environment *jni-states*)
            (setf (gethash environment *jni-states*) (make-jni-state))))))

(defun %jni-ref (object &optional (kind :local))
  (if (null object) 0
      (bordeaux-threads:with-recursive-lock-held (*jni-lock*)
        (let ((handle (incf *jni-counter*)))
          (setf (gethash handle *jni-references*)
                (make-jni-reference :object (if (eql kind :weak) (sb-ext:make-weak-pointer object) object)
                                    :kind kind :environment *jni-environment*))
          (when (eql kind :local) (push handle (first (jni-state-frames *jni-current-state*))))
          handle))))

(defun %jni-object (handle)
  (unless (zerop handle)
    (let ((reference (gethash handle *jni-references*)))
      (unless reference (%throw '|java/lang/IllegalArgumentException| "Invalid JNI reference"))
      (if (eql (jni-reference-kind reference) :weak)
          (sb-ext:weak-pointer-value (jni-reference-object reference))
          (jni-reference-object reference)))))

(defun %jni-pop-frame ()
  (dolist (handle (pop (jni-state-frames *jni-current-state*)))
    (remhash handle *jni-references*)))

(defun %jni-class (java-class)
  (let* ((loader (get-ldk-loader-for-java-loader (%class-java-loader java-class)))
         (name (substitute #\/ #\. (lstring (slot-value java-class '|name|)))))
    (or (%get-ldk-class-by-bin-name name t loader)
        (if (starts-with? "[" name) (%get-array-ldk-class-from-name name) (%resolve-class name loader)))))

(defun %jni-java-class (class)
  (java-class class))

(defun %jni-find-class (name)
  (when (starts-with? "[" name)
    (let* ((loader (jni-state-loader *jni-current-state*))
           (*descriptor-loader* (and loader (java-loader loader))))
      (return-from %jni-find-class (%descriptor-class name))))
  (let ((class (%resolve-class name (jni-state-loader *jni-current-state*))))
    (unless class (%throw '|java/lang/NoClassDefFoundError| name))
    (%clinit class)
    (%jni-java-class class)))

(defun %jni-descriptor-parts (descriptor)
  "Keep narrow primitive descriptors, which verification types intentionally merge."
  (let ((index 1) (parameters nil))
    (loop until (char= (char descriptor index) #\))
          do (let ((start index))
               (loop while (char= (char descriptor index) #\[) do (incf index))
               (if (char= (char descriptor index) #\L)
                   (setf index (1+ (position #\; descriptor :start index)))
                   (incf index))
               (push (subseq descriptor start index) parameters)))
    (values (nreverse parameters) (subseq descriptor (1+ index)))))

(defun %jni-decode (bits descriptor)
  (case (char descriptor 0)
    (#\V nil) (#\Z (logand bits 1)) (#\B (%jni-signed bits 8))
    (#\C (logand bits #xffff)) (#\S (%jni-signed bits 16))
    (#\I (%jni-signed bits 32)) (#\J (%jni-signed bits 64))
    (#\F (sb-kernel:make-single-float (%jni-signed bits 32)))
    (#\D (sb-kernel:make-double-float (%jni-signed (ash bits -32) 32) (logand bits #xffffffff)))
    (t (%jni-object bits))))

(defun %jni-encode (object descriptor)
  (%jni-u64
   (case (char descriptor 0)
     (#\V 0)
     (#\F (sb-kernel:single-float-bits (float object 1f0)))
     (#\D (sb-kernel:double-float-bits (float object 1d0)))
     ((#\L #\[) (%jni-ref object))
     (t (if (characterp object) (char-code object) (or object 0))))))

(defun %jni-member-owner (class member-name descriptor static-p field-p &optional seen)
  "Search superclasses and interfaces, without inheriting constructors."
  (when (and class (not (member class seen)))
    (when (find-if (lambda (entry)
                     (and (string= member-name (name entry)) (string= descriptor (descriptor entry))
                          (eql static-p (not (null (static-p entry))))))
                   (if field-p (fields class) (methods class)))
      (return-from %jni-member-owner class))
    (unless (string= member-name "<init>")
      (loop for parent in (remove nil (cons (super class) (coerce (interfaces class) 'list)))
            for owner = (%jni-member-owner (%resolve-class parent (ldk-loader class)) member-name descriptor
                                          static-p field-p (cons class seen))
            when owner return owner))))

(defun %jni-member-id (java-class member-name descriptor static-p field-p)
  (let* ((class (%jni-class java-class))
         (owner (progn (%clinit class) (%jni-member-owner class member-name descriptor static-p field-p))))
    (unless owner
      (%throw (if field-p '|java/lang/NoSuchFieldError| '|java/lang/NoSuchMethodError|)
              (format nil "~A.~A~A" (name class) member-name descriptor)))
    (bordeaux-threads:with-recursive-lock-held (*jni-lock*)
      (let* ((key (list owner member-name descriptor static-p field-p))
             (old (gethash key *jni-member-ids*)))
        (or old
            (let ((address (%jni-address (%jni-c "ldk_jni_member" sb-sys:system-area-pointer (sb-alien:c-string descriptor)))))
              (when (zerop address) (%throw '|java/lang/OutOfMemoryError|))
              (setf (gethash address *jni-members*)
                    (make-jni-member :class owner :name member-name :descriptor descriptor :static-p static-p :field-p field-p)
                    (gethash key *jni-member-ids*) address)))))))

(defun %jni-member-at (id)
  (or (gethash id *jni-members*) (%throw '|java/lang/IllegalArgumentException| "Invalid JNI member ID")))

(defun %jni-call-method (member receiver pointer &optional nonvirtual-class)
  (let* ((class (jni-member-class member))
         (descriptor (jni-member-descriptor member))
         (parameters (%jni-descriptor-parts descriptor))
         (args (loop for type in parameters for index from 0
                     collect (%jni-decode (%jni-arg pointer index) type)))
         (signature (lispize-method-name (concatenate 'string (jni-member-name member) descriptor))))
    (cond
      ((jni-member-static-p member)
       (%clinit class)
       (apply (symbol-function (static-method-symbol (format nil "~A.~A" (name class) signature)
                                                     (%class-loader-package class))) args))
      (nonvirtual-class
       (let* ((gf (fdefinition (intern signature :openldk)))
              (specializer (find-class (intern (name nonvirtual-class) (%class-specializer-package nonvirtual-class))))
              (method (find-method gf nil (cons specializer (make-list (length args) :initial-element (find-class t))) nil)))
         ;; Invoke just the requested class's method rather than CLOS's virtual dispatch.
         (unless method (%throw '|java/lang/NoSuchMethodError| signature))
         (funcall (closer-mop:method-function method) (cons receiver args) nil)))
      (t (apply (symbol-function (intern signature :openldk)) receiver args)))))

(defun %jni-field-storage (member receiver)
  (if (jni-member-static-p member)
      (let ((class (jni-member-class member)))
        (%clinit class)
        (symbol-value (intern (format nil "+static-~A+" (name class)) (%class-loader-package class))))
      (or receiver (%throw '|java/lang/NullPointerException|))))

(defun %jni-field-symbol (member)
  (let* ((class (jni-member-class member))
         (field (find (jni-member-name member) (fields class) :key #'name :test #'string=)))
    (unless field (%throw '|java/lang/NoSuchFieldError| (jni-member-name member)))
    (%field-slot-symbol class field (ldk-loader class))))

(defun %jni-text-utf16 (string)
  (coerce (loop for ch across string for code = (char-code ch)
                if (> code #xffff) append (list (+ #xd800 (ash (- code #x10000) -10))
                                                (+ #xdc00 (logand (- code #x10000) #x3ff)))
                  else collect code) 'vector))

(defun %jni-utf16 (string) (%jni-text-utf16 (lstring string)))

(defun %jni-mutf8 (units)
  (coerce (loop for code across units
                append (cond ((<= 1 code 127) (list code))
                             ((< code #x800) (list (logior #xc0 (ash code -6)) (logior #x80 (logand code 63))))
                             (t (list (logior #xe0 (ash code -12)) (logior #x80 (logand (ash code -6) 63))
                                      (logior #x80 (logand code 63)))))) '(vector (unsigned-byte 8))))

(defun %jni-read-mutf8 (pointer)
  (let ((units nil) (index 0))
    (loop for first = (sb-sys:sap-ref-8 pointer index) until (zerop first)
          do (incf index)
             (push (cond ((< first #x80) first)
                         ((< first #xe0)
                          (prog1 (logior (ash (logand first 31) 6)
                                         (logand (sb-sys:sap-ref-8 pointer index) 63)) (incf index)))
                         (t (prog1 (logior (ash (logand first 15) 12)
                                           (ash (logand (sb-sys:sap-ref-8 pointer index) 63) 6)
                                           (logand (sb-sys:sap-ref-8 pointer (1+ index)) 63)) (incf index 2)))) units))
    (jstring (map 'string #'code-char (nreverse units)))))

(defun %jni-malloc (size)
  (let ((pointer (%jni-c "calloc" sb-sys:system-area-pointer
                         (sb-alien:unsigned-long (max size 1)) (sb-alien:unsigned-long 1))))
    (when (zerop (%jni-address pointer)) (%throw '|java/lang/OutOfMemoryError|))
    pointer))

(defun %jni-free (pointer)
  (%jni-c "free" sb-alien:void (sb-sys:system-area-pointer pointer)))

(defparameter *jni-primitives*
  '(("Boolean" "Z" "boolean" 1) ("Byte" "B" "byte" 1) ("Char" "C" "char" 2)
    ("Short" "S" "short" 2) ("Int" "I" "int" 4) ("Long" "J" "long" 8)
    ("Float" "F" "float" 4) ("Double" "D" "double" 8)))

(defun %jni-memory-read (pointer offset type)
  (case (char type 0)
    (#\F (sb-sys:sap-ref-single pointer offset)) (#\D (sb-sys:sap-ref-double pointer offset))
    (#\J (%jni-signed (sb-sys:sap-ref-64 pointer offset) 64))
    (#\I (%jni-signed (sb-sys:sap-ref-32 pointer offset) 32))
    (#\C (sb-sys:sap-ref-16 pointer offset)) (#\S (%jni-signed (sb-sys:sap-ref-16 pointer offset) 16))
    (#\B (%jni-signed (sb-sys:sap-ref-8 pointer offset) 8)) (#\Z (sb-sys:sap-ref-8 pointer offset))))

(defun %jni-memory-write (pointer offset type value)
  (case (char type 0)
    (#\F (setf (sb-sys:sap-ref-single pointer offset) (float value 1f0)))
    (#\D (setf (sb-sys:sap-ref-double pointer offset) (float value 1d0)))
    (#\J (setf (sb-sys:sap-ref-64 pointer offset) (%jni-u64 value)))
    (#\I (setf (sb-sys:sap-ref-32 pointer offset) (logand value #xffffffff)))
    ((#\C #\S) (setf (sb-sys:sap-ref-16 pointer offset) (logand value #xffff)))
    (t (setf (sb-sys:sap-ref-8 pointer offset) (logand value #xff)))))

(defun %jni-check-region (data start length)
  (unless (and (<= 0 start) (<= 0 length) (<= (+ start length) (length data)))
    (%throw '|java/lang/ArrayIndexOutOfBoundsException|)))

(defun %jni-array-transfer (array pointer primitive start count to-native)
  (destructuring-bind (name type java-name width) primitive
    (declare (ignore name java-name))
    (let ((data (java-array-data array)))
      (%jni-check-region data start count)
      (dotimes (i count)
        (if to-native (%jni-memory-write pointer (* i width) type (aref data (+ start i)))
            (setf (aref data (+ start i)) (%array-value (array-element-type data)
                                                     (%jni-memory-read pointer (* i width) type))))))))

(defun %jni-operation (operation args)
  "Run an ABI operation. Argument zero is the owning thread's JNIEnv*."
  (flet ((arg (index) (%jni-arg args index))
         (obj (index) (%jni-object (%jni-arg args index)))
         (ptr (index) (%jni-pointer (%jni-arg args index)))
         (text (index) (%jni-cstring (%jni-arg args index)))
         (int (index) (%jni-signed (%jni-arg args index) 32)))
    (cond
      ((string= operation "GetVersion") #x00180000)
      ((string= operation "FindClass") (%jni-ref (%jni-find-class (text 1))))
      ((string= operation "DefineClass")
       (when (minusp (int 4)) (%throw '|java/lang/ClassFormatError| "Negative classfile length"))
       (let ((bytes (make-java-array :component-class (%get-java-class-by-bin-name "byte") :size (int 4))))
         (dotimes (i (int 4)) (setf (aref (java-array-data bytes) i) (%jni-signed (sb-sys:sap-ref-8 (ptr 3) i) 8)))
         (%jni-ref (|java/lang/ClassLoader.defineClass1(Ljava/lang/ClassLoader;Ljava/lang/String;[BIILjava/security/ProtectionDomain;Ljava/lang/String;)Ljava/lang/Class;|
                    (obj 2) (unless (zerop (arg 1)) (%jni-read-mutf8 (ptr 1))) bytes 0 (int 4) nil nil))))
      ((string= operation "GetModule") (%jni-ref (slot-value (obj 1) '|module|)))
      ((string= operation "IsVirtualThread") (|isVirtual()Z| (obj 1)))
      ((member operation '("FromReflectedMethod" "FromReflectedField") :test #'string=)
       (let* ((object (obj 1)) (field-p (string= operation "FromReflectedField"))
              (member (unless field-p (%executable-method object))))
         (%jni-member-id (slot-value object '|clazz|)
                          (if field-p (lstring (slot-value object '|name|)) (name member))
                          (if field-p (%class-descriptor (slot-value object '|type$|)) (descriptor member))
                          (not (zerop (logand (slot-value object '|modifiers|) 8))) field-p)))
      ((member operation '("ToReflectedMethod" "ToReflectedField") :test #'string=)
       (let* ((member (%jni-member-at (arg 2))) (java-class (%jni-java-class (jni-member-class member)))
              (field-p (jni-member-field-p member))
              (entries (cond (field-p (|getDeclaredFields0(Z)[Ljava/lang/reflect/Field;| java-class 0))
                             ((string= (jni-member-name member) "<init>") (|getDeclaredConstructors0(Z)[Ljava/lang/reflect/Constructor;| java-class 0))
                             (t (|getDeclaredMethods0(Z)[Ljava/lang/reflect/Method;| java-class 0)))))
         (%jni-ref (find-if (lambda (entry)
                             (if field-p
                                 (and (string= (lstring (slot-value entry '|name|)) (jni-member-name member))
                                      (string= (%class-descriptor (slot-value entry '|type$|)) (jni-member-descriptor member)))
                                 (let ((method (%executable-method entry)))
                                   (and method (string= (name method) (jni-member-name member))
                                        (string= (descriptor method) (jni-member-descriptor member))))))
                           (java-array-data entries)))))
      ((string= operation "GetObjectClass")
       (%jni-ref (|getClass()Ljava/lang/Class;| (obj 1))))
      ((string= operation "GetSuperclass")
       (cond ((= 1 (|isPrimitive()Z| (obj 1))) 0)
             ((starts-with? "[" (lstring (slot-value (obj 1) '|name|))) (%jni-ref (%jni-find-class "java/lang/Object")))
             (t (let* ((class (%jni-class (obj 1))) (super (unless (interface-p class) (super class))))
                  (%jni-ref (and super (%jni-find-class super)))))))
      ((string= operation "IsSameObject") (if (eq (obj 1) (obj 2)) 1 0))
      ((string= operation "IsInstanceOf")
       (let ((name (substitute #\/ #\. (lstring (slot-value (obj 2) '|name|)))))
         (cond ((null (obj 1)) 1)
               ((starts-with? "[" name) (%instanceof-array (obj 1) name))
               (t (let ((class (%jni-class (obj 2))))
                    (%instanceof-check (obj 1) name (intern name (%class-specializer-package class))))))))
      ((string= operation "IsAssignableFrom")
       (|isAssignableFrom(Ljava/lang/Class;)Z| (obj 2) (obj 1)))
      ((member operation '("NewLocalRef" "NewGlobalRef" "NewWeakGlobalRef") :test #'string=)
       (%jni-ref (obj 1) (cond ((string= operation "NewGlobalRef") :global)
                              ((string= operation "NewWeakGlobalRef") :weak) (t :local))))
      ((member operation '("DeleteLocalRef" "DeleteGlobalRef" "DeleteWeakGlobalRef") :test #'string=)
       (remhash (arg 1) *jni-references*) 0)
      ((string= operation "GetObjectRefType")
       (let ((ref (gethash (arg 1) *jni-references*)))
         (case (and ref (jni-reference-kind ref)) (:local 1) (:global 2) (:weak 3) (t 0))))
      ((string= operation "PushLocalFrame")
       (when (minusp (int 1)) (%throw '|java/lang/IllegalArgumentException|))
       (push nil (jni-state-frames *jni-current-state*)) 0)
      ((string= operation "PopLocalFrame") (let ((result (obj 1))) (%jni-pop-frame) (%jni-ref result)))
      ((string= operation "EnsureLocalCapacity") (if (minusp (int 1)) -1 0))
      ((string= operation "ExceptionCheck") (if (jni-state-pending *jni-current-state*) 1 0))
      ((string= operation "ExceptionOccurred") (%jni-ref (jni-state-pending *jni-current-state*)))
      ((string= operation "ExceptionClear") (setf (jni-state-pending *jni-current-state*) nil) 0)
      ((string= operation "ExceptionDescribe")
       (when (jni-state-pending *jni-current-state*)
         (%print-java-stack-trace (jni-state-pending *jni-current-state*) :stream *error-output*))
       (setf (jni-state-pending *jni-current-state*) nil) 0)
      ((string= operation "Throw") (setf (jni-state-pending *jni-current-state*) (obj 1)) 0)
      ((string= operation "ThrowNew")
       (let* ((class (%jni-class (obj 1))) (exception (%make-java-instance (name class))))
         (|<init>(Ljava/lang/String;)V| exception (if (zerop (arg 2)) nil (%jni-read-mutf8 (ptr 2))))
         (setf (jni-state-pending *jni-current-state*) exception)) 0)
      ((string= operation "FatalError") (format *error-output* "JNI FatalError: ~A~%" (text 1)) (sb-ext:exit :code 1))
      ((member operation '("GetMethodID" "GetStaticMethodID" "GetFieldID" "GetStaticFieldID") :test #'string=)
       (%jni-member-id (obj 1) (text 2) (text 3) (not (null (search "Static" operation)))
                       (not (null (search "Field" operation)))))
      ((and (starts-with? "Call" operation) (ends-with? "MethodA" operation))
       (let* ((nonvirtual (search "Nonvirtual" operation))
              (member (%jni-member-at (arg (if nonvirtual 3 2))))
              (result (%jni-call-method member (obj 1) (ptr (if nonvirtual 4 3))
                                        (and nonvirtual (%jni-class (obj 2))))))
         (%jni-encode result (nth-value 1 (%jni-descriptor-parts (jni-member-descriptor member))))))
      ((member operation '("AllocObject" "NewObjectA") :test #'string=)
       (let* ((class (%jni-class (obj 1)))
              (object (progn
                        (when (or (interface-p class) (not (zerop (logand (access-flags class) #x400))))
                          (%throw '|java/lang/InstantiationException| (name class)))
                        (%clinit class) (%make-java-instance (name class) (ldk-loader class)))))
         (when (string= operation "NewObjectA") (%jni-call-method (%jni-member-at (arg 2)) object (ptr 3)))
         (%jni-ref object)))
      ((and (or (starts-with? "Get" operation) (starts-with? "Set" operation)) (ends-with? "Field" operation))
       (let* ((member (%jni-member-at (arg 2))) (storage (%jni-field-storage member (obj 1)))
              (slot (%jni-field-symbol member)))
         (with-java-memory-ordering
           (if (starts-with? "Get" operation)
               (%jni-encode (slot-value storage slot) (jni-member-descriptor member))
               (progn (setf (slot-value storage slot) (%jni-decode (arg 3) (jni-member-descriptor member))) 0)))))
      ((string= operation "GetArrayLength") (length (java-array-data (obj 1))))
      ((string= operation "NewObjectArray")
       (when (minusp (int 1)) (%throw '|java/lang/NegativeArraySizeException|))
       (%jni-ref (make-java-array :component-class (obj 2) :size (int 1) :initial-element (obj 3))))
      ((string= operation "GetObjectArrayElement")
       (let ((data (java-array-data (obj 1)))) (%jni-check-region data (int 2) 1) (%jni-ref (aref data (int 2)))))
      ((string= operation "SetObjectArrayElement")
       (let ((array (obj 1))) (%jni-check-region (java-array-data array) (int 2) 1)
         (%aastore array (int 2) (obj 3))) 0)
      ((member operation '("MonitorEnter" "MonitorExit") :test #'string=)
       (unless (obj 1) (%throw '|java/lang/NullPointerException|))
       (let* ((object (obj 1)) (entry (assoc object (jni-state-monitors *jni-current-state*))))
         (if (string= operation "MonitorEnter")
             (progn (monitor-enter object)
                    (if entry (incf (cdr entry)) (push (cons object 1) (jni-state-monitors *jni-current-state*))))
             (progn (monitor-exit object)
                    (when (and entry (zerop (decf (cdr entry))))
                      (setf (jni-state-monitors *jni-current-state*) (remove entry (jni-state-monitors *jni-current-state*))))))) 0)
      ((string= operation "GetJavaVM")
       (setf (sb-sys:sap-ref-sap (ptr 1) 0) (%jni-c "ldk_jni_vm" sb-sys:system-area-pointer)) 0)
      ((string= operation "RegisterNatives")
       (let ((class (%jni-class (obj 1))))
         (dotimes (i (int 3))
           (let* ((entry (sb-sys:sap+ (ptr 2) (* i 24)))
                  (name (%jni-cstring (sb-sys:sap-ref-64 entry 0)))
                  (signature (%jni-cstring (sb-sys:sap-ref-64 entry 8)))
                  (method (find-if (lambda (m) (and (string= (name m) name) (string= (descriptor m) signature))) (methods class))))
             (unless (and method (native-p method)) (%throw '|java/lang/NoSuchMethodError| name))
             (when (jni-state-loading-library *jni-current-state*)
               (push (list (list class name signature) (gethash (list class name signature) *jni-bindings*)
                           (sb-sys:sap-ref-64 entry 16))
                     (jni-library-registrations (jni-state-loading-library *jni-current-state*))))
             (setf (gethash (list class name signature) *jni-bindings*) (sb-sys:sap-ref-64 entry 16))))) 0)
      ((string= operation "UnregisterNatives")
       (let ((class (%jni-class (obj 1))))
         (maphash (lambda (key value) (declare (ignore value))
                    (when (eql (first key) class) (remhash key *jni-bindings*))) *jni-bindings*)) 0)
      ((member operation '("GetStringLength" "GetStringUTFLength" "GetStringUTFLengthAsLong") :test #'string=)
       (let ((units (%jni-utf16 (obj 1))))
         (length (if (string= operation "GetStringLength") units (%jni-mutf8 units)))))
      ((member operation '("GetStringChars" "GetStringCritical" "GetStringUTFChars") :test #'string=)
       (let* ((utf (string= operation "GetStringUTFChars"))
              (data (if utf (%jni-mutf8 (%jni-utf16 (obj 1))) (%jni-utf16 (obj 1))))
              (width (if utf 1 2)) (buffer (%jni-malloc (* width (1+ (length data))))))
         (unless (zerop (arg 2)) (setf (sb-sys:sap-ref-8 (ptr 2) 0) 1))
         (dotimes (i (length data)) (%jni-memory-write buffer (* i width) (if utf "B" "C") (aref data i)))
         (%jni-address buffer)))
      ((member operation '("ReleaseStringChars" "ReleaseStringUTFChars" "ReleaseStringCritical") :test #'string=)
       (%jni-free (ptr 2)) 0)
      ((string= operation "NewStringUTF") (%jni-ref (%jni-read-mutf8 (ptr 1))))
      ((string= operation "NewString")
       (when (minusp (int 2)) (%throw '|java/lang/IllegalArgumentException|))
       (%jni-ref (jstring (coerce (loop for i below (int 2) collect (code-char (sb-sys:sap-ref-16 (ptr 1) (* i 2)))) 'string))))
      ((member operation '("GetStringRegion" "GetStringUTFRegion") :test #'string=)
       (let ((data (%jni-utf16 (obj 1))))
         (%jni-check-region data (int 2) (int 3))
         (let* ((utf (string= operation "GetStringUTFRegion"))
                (part (subseq data (int 2) (+ (int 2) (int 3))))
                (output (if utf (%jni-mutf8 part) part)))
           (dotimes (i (length output)) (%jni-memory-write (ptr 4) (* i (if utf 1 2)) (if utf "B" "C") (aref output i))))) 0)
      ((string= operation "AttachCurrentThread") (%jni-attach (arg 0) (arg 1) (not (zerop (arg 2)))) 0)
      ((string= operation "DetachCurrentThread") (%jni-detach) 0)
      ((string= operation "NewDirectByteBuffer")
       (let ((capacity (%jni-signed (arg 2) 64)))
         (unless (<= 0 capacity #x7fffffff) (%throw '|java/lang/IllegalArgumentException| "Invalid direct buffer capacity"))
         (%clinit (classload "java/nio/DirectByteBuffer"))
         (let ((buffer (%make-java-instance "java/nio/DirectByteBuffer")))
           (|<init>(JJ)V| buffer (%jni-signed (arg 1) 64) capacity)
           (%jni-ref buffer))))
      ((member operation '("GetDirectBufferAddress" "GetDirectBufferCapacity") :test #'string=)
       (let ((buffer (obj 1)))
         (if (and buffer (slot-exists-p buffer '|address|) (= 1 (|isDirect()Z| buffer)))
             (slot-value buffer (if (string= operation "GetDirectBufferAddress") '|address| '|capacity|))
             (if (string= operation "GetDirectBufferAddress") 0 -1))))
      (t (%jni-extra-operation operation args)))))

(defun %jni-extra-operation (operation args)
  "The repeated primitive-array API shares one implementation."
  (let* ((primitive (find-if (lambda (entry) (search (first entry) operation)) *jni-primitives*))
         (array (unless (starts-with? "New" operation) (%jni-object (%jni-arg args 1))))
         (pointer (%jni-pointer (%jni-arg args 2))))
    (cond
      ((and primitive (starts-with? "New" operation) (ends-with? "Array" operation))
       (let ((size (%jni-signed (%jni-arg args 1) 32)))
         (when (minusp size) (%throw '|java/lang/NegativeArraySizeException|))
         (%jni-ref (make-java-array :component-class (%get-java-class-by-bin-name (third primitive)) :size size :initial-element 0))))
      ((and primitive (ends-with? "ArrayRegion" operation))
       (%jni-array-transfer array (%jni-pointer (%jni-arg args 4)) primitive
                            (%jni-signed (%jni-arg args 2) 32) (%jni-signed (%jni-arg args 3) 32)
                            (starts-with? "Get" operation)) 0)
      ((or (and primitive (ends-with? "ArrayElements" operation))
           (member operation '("GetPrimitiveArrayCritical" "ReleasePrimitiveArrayCritical") :test #'string=))
       (let* ((primitive (or primitive
                             (find (%component-element-type (java-array-component-class array)) *jni-primitives*
                                   :key (lambda (entry) (%primitive-element-type (third entry))) :test #'equal)))
              (size (length (java-array-data array))))
         (unless primitive (%throw '|java/lang/IllegalArgumentException| "Not a primitive array"))
         (if (starts-with? "Get" operation)
             (let ((buffer (%jni-malloc (* size (fourth primitive)))))
               (%jni-array-transfer array buffer primitive 0 size t)
               (unless (zerop (%jni-arg args 2)) (setf (sb-sys:sap-ref-8 pointer 0) 1))
               (%jni-address buffer))
             (let ((mode (%jni-arg args 3)))
               (unless (= mode 2) (%jni-array-transfer array pointer primitive 0 size nil))
               (unless (= mode 1) (%jni-free pointer)) 0))))
      (t (%throw '|java/lang/UnsupportedOperationException| (format nil "JNI ~A is not implemented" operation))))))

(defun %jni-attach (environment arguments daemon-p)
  (declare (ignore environment))
  (sb-int:set-floating-point-modes :traps nil)
  (let* ((thread (%make-java-instance "java/lang/Thread"))
         (name (and (not (zerop arguments)) (sb-sys:sap-ref-64 (%jni-pointer arguments) 8))))
    (|<init>(Ljava/lang/String;)V| thread (jstring (if (and name (not (zerop name))) (%jni-cstring name) "JNI attached thread")))
    (|setDaemon(Z)V| thread (if daemon-p 1 0))
    (when (not (zerop arguments))
      (let ((group (%jni-object (sb-sys:sap-ref-64 (%jni-pointer arguments) 16))))
        (when group (setf (slot-value (slot-value thread '|holder|) '|group|) group))))
    (setf (slot-value thread '|eetop|) 1)
    (%set-thread-status thread 4)
    (setf (jni-state-java-thread *jni-current-state*) thread
          (gethash (bordeaux-threads:current-thread) *lisp-to-java-threads*) thread)))

(defun %jni-detach ()
  (dolist (entry (jni-state-monitors *jni-current-state*))
    (dotimes (i (cdr entry)) (monitor-exit (car entry))))
  (setf (jni-state-monitors *jni-current-state*) nil)
  (let ((thread (jni-state-java-thread *jni-current-state*)))
    (when thread
      (setf (slot-value thread '|eetop|) 0)
      (%set-thread-status thread 2)
      (monitor-enter thread)
      (unwind-protect (|notifyAll()V| thread) (monitor-exit thread))))
  (loop while (jni-state-frames *jni-current-state*) do (%jni-pop-frame))
  (remhash (bordeaux-threads:current-thread) *lisp-to-java-threads*)
  (remhash *jni-environment* *jni-states*))

(defun %jni-nondaemon-threads ()
  "Foreign threads remain alive between SBCL callbacks until JNI detachment."
  (loop for state being the hash-values of *jni-states*
        for thread = (jni-state-java-thread state)
        when (and thread (not (%thread-daemon-p thread))
                  (not (zerop (slot-value thread '|eetop|))))
          collect thread))

(sb-alien:define-alien-callable %jni-dispatch sb-alien:unsigned-long-long
    ((operation sb-alien:c-string) (args sb-sys:system-area-pointer))
  (let* ((*jni-environment* (%jni-arg args 0))
         (*jni-current-state* (%jni-state *jni-environment*))
         (foreign-thread (jni-state-java-thread *jni-current-state*))
         (lisp-thread (bordeaux-threads:current-thread))
         (previous-thread (gethash lisp-thread *lisp-to-java-threads*))
         (*foreign-thread-identity* (or foreign-thread *foreign-thread-identity*))
         (*current-thread* (or foreign-thread *current-thread*))
         (*scoped-value-cache* (if foreign-thread (jni-state-scoped-cache *jni-current-state*) *scoped-value-cache*)))
    (when foreign-thread (setf (gethash lisp-thread *lisp-to-java-threads*) foreign-thread))
    ;; Java exceptions must return through C as pending exceptions; no condition
    ;; may unwind through third-party C/C++ frames.
    (unwind-protect
         (handler-case (%jni-u64 (or (%jni-operation operation args) 0))
      (error (condition)
        (when *debug-exceptions* (format *error-output* "~&JNI ~A failed: ~A~%" operation condition))
        (setf (jni-state-pending *jni-current-state*)
              (if (typep condition '|condition-java/lang/Throwable|)
                  (slot-value condition '|objref|)
                  (%make-throwable '|java/lang/InternalError| (princ-to-string condition))))
        (if (member operation '("RegisterNatives" "UnregisterNatives" "ThrowNew" "MonitorEnter" "MonitorExit" "PushLocalFrame") :test #'string=)
            #xffffffffffffffff 0)))
      (when (jni-state-java-thread *jni-current-state*)
        (setf (jni-state-scoped-cache *jni-current-state*) *scoped-value-cache*)
        (if previous-thread (setf (gethash lisp-thread *lisp-to-java-threads*) previous-thread)
            (remhash lisp-thread *lisp-to-java-threads*))))))

(defun %ensure-jni ()
  (bordeaux-threads:with-recursive-lock-held (*jni-lock*)
    (unless *jni-loaded*
      (let ((path (or (uiop:getenv "OPENLDK_JNI_BRIDGE") *jni-default-shim*)))
        (unless (probe-file path) (%throw '|java/lang/UnsatisfiedLinkError| "Build JNI support with make jni"))
        (sb-alien:load-shared-object path))
      (%jni-c "ldk_jni_init" sb-alien:void
              (sb-sys:system-area-pointer (sb-alien:alien-sap (sb-alien:alien-callable-function '%jni-dispatch))))
      (setf *jni-loaded* t))))

(defun %jni-call-native-unlocked (class method receiver arguments)
  (%ensure-jni)
  (let* ((*jni-environment* (%jni-address (%jni-c "ldk_jni_env" sb-sys:system-area-pointer)))
         (*jni-current-state* (%jni-state *jni-environment*))
         (previous-loader (jni-state-loader *jni-current-state*))
         (previous-depth (length (jni-state-frames *jni-current-state*)))
         (descriptor (descriptor method))
         (parameters (%jni-descriptor-parts descriptor))
         (result-type (nth-value 1 (%jni-descriptor-parts descriptor)))
         (function (%jni-resolve-native class method))
         (memory (%jni-malloc (* 8 (max 1 (length arguments)))))
         (result (%jni-malloc 8)))
    (setf (jni-state-loader *jni-current-state*) (ldk-loader class))
    (push nil (jni-state-frames *jni-current-state*))
    (unwind-protect
         (progn
           (loop for value in arguments for type in parameters for index from 0
                 do (setf (sb-sys:sap-ref-64 memory (* index 8)) (%jni-encode value type)))
           (unless (zerop (%jni-c "ldk_jni_invoke" sb-alien:int
                                   (sb-sys:system-area-pointer (%jni-pointer function))
                                   (sb-alien:c-string descriptor)
                                   (sb-alien:unsigned-long (%jni-ref (if (static-p method) (%jni-java-class class) receiver)))
                                   (sb-sys:system-area-pointer memory) (sb-sys:system-area-pointer result)))
             (%throw '|java/lang/UnsatisfiedLinkError| "Invalid JNI calling signature"))
           (when (jni-state-pending *jni-current-state*)
             (let ((exception (jni-state-pending *jni-current-state*)))
               (setf (jni-state-pending *jni-current-state*) nil)
               (error (%lisp-condition exception))))
           (%jni-decode (sb-sys:sap-ref-64 result 0) result-type))
      (loop while (> (length (jni-state-frames *jni-current-state*)) previous-depth) do (%jni-pop-frame))
      (setf (jni-state-loader *jni-current-state*) previous-loader)
      (%jni-free memory) (%jni-free result))))

(defun %jni-call-native (class method receiver arguments)
  (if (zerop (logand (access-flags method) #x20))
      (%jni-call-native-unlocked class method receiver arguments)
      (let ((monitor (if (static-p method) (%jni-java-class class) receiver)))
        (monitor-enter monitor)
        (unwind-protect (%jni-call-native-unlocked class method receiver arguments)
          (monitor-exit monitor)))))

(defun %jni-mangle (text)
  (with-output-to-string (stream)
    (loop for code across (%jni-text-utf16 text) for ch = (code-char code)
          do (cond ((or (<= 65 code 90) (<= 97 code 122) (<= 48 code 57)) (write-char ch stream))
                   ((char= ch #\/) (write-char #\_ stream))
                   ((char= ch #\_) (write-string "_1" stream))
                   ((char= ch #\;) (write-string "_2" stream))
                   ((char= ch #\[) (write-string "_3" stream))
                   (t (write-string (string-downcase (format nil "_0~4,'0x" code)) stream))))))

(defun %jni-resolve-native (class method)
  (let* ((key (list class (name method) (descriptor method)))
         (registered (gethash key *jni-bindings*)))
    (or registered
        (let* ((short (format nil "Java_~A_~A" (%jni-mangle (name class)) (%jni-mangle (name method))))
               (long (format nil "~A__~A" short (%jni-mangle (subseq (descriptor method) 1 (position #\) (descriptor method)))))))
          (bordeaux-threads:with-recursive-lock-held (*jni-lock*)
            (dolist (symbol-name (list short long))
              (dolist (library *jni-libraries*)
                (when (eq (jni-library-loader library) (ldk-loader class))
                  (let ((address (%jni-address
                                  (%jni-c "ldk_jni_symbol" sb-sys:system-area-pointer
                                          (sb-sys:system-area-pointer (%jni-pointer (jni-library-address library)))
                                          (sb-alien:c-string symbol-name)))))
                    (unless (zerop address)
                      (%jni-ensure-native-access (%jni-java-class class) (%jni-java-class class) (name method) t)
                      (setf (gethash key *jni-bindings*) address)
                      (return-from %jni-resolve-native address)))))))
          (%throw '|java/lang/UnsatisfiedLinkError| (format nil "~A.~A~A" (name class) (name method) (descriptor method)))))))

(defun %jni-wait-library (library)
  (unless (eq (jni-library-owner library) (bordeaux-threads:current-thread))
    (bordeaux-threads:with-lock-held ((jni-library-mutex library))
      (loop while (eql (jni-library-state library) :loading)
            do (bordeaux-threads:condition-wait (jni-library-condition library) (jni-library-mutex library)))))
  (when (eql (jni-library-state library) :failed)
    (%throw '|java/lang/UnsatisfiedLinkError| "JNI library initialization failed")))

(defun %jni-load-library (path loader)
  "Reserve ownership under the registry lock, then run foreign code unlocked."
  (%ensure-jni)
  (unless (probe-file path) (%throw '|java/lang/UnsatisfiedLinkError| (format nil "Native library not found: ~A" path)))
  (let ((path (namestring (truename path))) (library nil) (fresh nil))
    (bordeaux-threads:with-recursive-lock-held (*jni-lock*)
      (setf library (find path *jni-libraries* :key #'jni-library-path :test #'string=))
      (if library
          (unless (eq (jni-library-loader library) loader)
            (%throw '|java/lang/UnsatisfiedLinkError| "Native library already loaded in another class loader"))
          (let ((address (%jni-address (%jni-c "ldk_jni_open" sb-sys:system-area-pointer (sb-alien:c-string path)))))
            (when (zerop address)
              (%throw '|java/lang/UnsatisfiedLinkError| (%jni-c "ldk_jni_error" sb-alien:c-string)))
            (setf library (make-jni-library :path path :loader loader :address address
                                            :owner (bordeaux-threads:current-thread))
                  fresh t)
            (push library *jni-libraries*))))
    (unless fresh (%jni-wait-library library) (return-from %jni-load-library nil))
    (let* ((*jni-environment* (%jni-address (%jni-c "ldk_jni_env" sb-sys:system-area-pointer)))
           (*jni-current-state* (%jni-state *jni-environment*))
           (previous-loader (jni-state-loader *jni-current-state*))
           (previous-library (jni-state-loading-library *jni-current-state*))
           (previous-depth (length (jni-state-frames *jni-current-state*)))
           (success nil))
      (push nil (jni-state-frames *jni-current-state*))
      (setf (jni-state-loader *jni-current-state*) loader
            (jni-state-loading-library *jni-current-state*) library)
      (unwind-protect
           (let ((onload (%jni-c "ldk_jni_symbol" sb-sys:system-area-pointer
                                 (sb-sys:system-area-pointer (%jni-pointer (jni-library-address library)))
                                 (sb-alien:c-string "JNI_OnLoad"))))
             (unless (zerop (%jni-address onload))
               (let ((version (%jni-c "ldk_jni_onload" sb-alien:int (sb-sys:system-area-pointer onload))))
                 (when (or (zerop version) (jni-state-pending *jni-current-state*))
                   (setf (jni-state-pending *jni-current-state*) nil)
                   (%throw '|java/lang/UnsatisfiedLinkError| "JNI_OnLoad failed or returned an unsupported JNI version"))))
             (setf success t))
        (loop while (> (length (jni-state-frames *jni-current-state*)) previous-depth) do (%jni-pop-frame))
        (setf (jni-state-loader *jni-current-state*) previous-loader
              (jni-state-loading-library *jni-current-state*) previous-library)
        (unless success
          (bordeaux-threads:with-recursive-lock-held (*jni-lock*)
            (setf *jni-libraries* (remove library *jni-libraries*))
            (dolist (registration (jni-library-registrations library))
              (destructuring-bind (key old new) registration
                (when (eql (gethash key *jni-bindings*) new)
                  (if old (setf (gethash key *jni-bindings*) old) (remhash key *jni-bindings*))))))
          (%jni-c "ldk_jni_close" sb-alien:void (sb-sys:system-area-pointer (%jni-pointer (jni-library-address library)))))
        (bordeaux-threads:with-lock-held ((jni-library-mutex library))
          (setf (jni-library-state library) (if success :loaded :failed)
                (jni-library-owner library) nil
                (jni-library-registrations library) nil)
          (sb-thread:condition-broadcast (jni-library-condition library))))))
  nil)

(defun %jni-loading-class (function)
  (or (%java-caller-class function)
      (some #'%frame-caller-java-class (%filtered-backtrace))))

(defun %jni-system-load (filename &optional explicit-caller)
  (let* ((path (lstring filename))
         (caller (or explicit-caller (%jni-loading-class '%jni-system-load))))
    (when (and caller (jdk-class-p (name (%jni-class caller))))
      (return-from %jni-system-load nil))
    (%jni-ensure-native-access caller (%get-java-class-by-bin-name "java/lang/System") "load")
    (unless filename (%throw '|java/lang/NullPointerException|))
    (unless (uiop:absolute-pathname-p path)
      (%throw '|java/lang/UnsatisfiedLinkError| "System.load requires an absolute path"))
    (%jni-load-library path (if caller (ldk-loader (%jni-class caller))
                               (and *jni-current-state* (jni-state-loader *jni-current-state*))))))

(defun %jni-system-load-library (library-name &optional explicit-caller)
  (let* ((name (lstring library-name))
         (caller (or explicit-caller (%jni-loading-class '%jni-system-load-library)))
         (class (and caller (%jni-class caller)))
         (loader (if class (ldk-loader class) (and *jni-current-state* (jni-state-loader *jni-current-state*)))))
    ;; JDK services are supplied by the existing CL natives. Only their own
    ;; library notifications are fulfilled internally; user libraries use JNI.
    (when (and class (jdk-class-p (name class)))
      (return-from %jni-system-load-library nil))
    (%jni-ensure-native-access caller (%get-java-class-by-bin-name "java/lang/System") "loadLibrary")
    (when (or (find #\/ name) (find #\\ name))
      (%throw '|java/lang/UnsatisfiedLinkError| "Library name contains a path separator"))
    (let* ((filename (format nil "lib~A.so" name))
           (property (|java/lang/System.getProperty(Ljava/lang/String;)Ljava/lang/String;| (jstring "java.library.path")))
           (paths (split-sequence:split-sequence #\: (or (lstring property) (uiop:getenv "LD_LIBRARY_PATH") ".")))
           (path (loop for directory in paths
                       for candidate = (merge-pathnames filename (uiop:ensure-directory-pathname (if (string= directory "") "." directory)))
                       when (probe-file candidate) return candidate)))
      (unless path (%throw '|java/lang/UnsatisfiedLinkError| (format nil "No ~A in java.library.path" name)))
      (%jni-load-library path loader))))

(setf (gethash "java/lang/System.load(Ljava/lang/String;)V" *native-overrides*) #'%jni-system-load
      (gethash "java/lang/System.loadLibrary(Ljava/lang/String;)V" *native-overrides*) #'%jni-system-load-library
      (gethash "java/lang/Runtime.load0(Ljava/lang/Class;Ljava/lang/String;)V" *native-overrides*)
      (lambda (this caller filename)
        (declare (ignore this))
        (%jni-system-load filename caller))
      (gethash "java/lang/Runtime.loadLibrary0(Ljava/lang/Class;Ljava/lang/String;)V" *native-overrides*)
      (lambda (this caller name)
        (declare (ignore this))
        (%jni-system-load-library name caller)))

(defun %install-jni-method-stubs (class loader)
  "Install JNI fallbacks only where no handwritten CL native exists."
  ;; JDK natives include bootstrapping and short-name forwarding installed later
  ;; by %ADOPT-NATIVE-SHORT-METHODS. Keep their existing CL resolution intact.
  ;; The fallback linker's natives are supplied by OpenLDK's own libffi shim.
  (when (and (jdk-class-p (name class))
             (not (string= (name class) "jdk/internal/foreign/abi/fallback/LibFallback")))
    (return-from %install-jni-method-stubs nil))
  (loop for method across (methods class) when (native-p method)
        do (let* ((signature (lispize-method-name (concatenate 'string (name method) (descriptor method))))
                  (full (format nil "~A.~A" (name class) signature)))
             (unless (gethash full *native-overrides*)
               (if (static-p method)
                   (let ((symbol (static-method-symbol full (loader-package loader))))
                     (unless (fboundp symbol)
                       (let ((method method))
                         (setf (fdefinition symbol)
                               (lambda (&rest args)
                                 (%verify-class-for-java class)
                                 (%jni-call-native class method nil args))))))
                   (let* ((symbol (intern signature :openldk))
                          (count (count-parameters (descriptor method)))
                          (specializer (find-class (intern (name class) (%class-specializer-package class)))))
                     (%ensure-java-gf symbol (1+ count))
                     (let* ((gf (fdefinition symbol))
                            (specializers (cons specializer (make-list count :initial-element (find-class t)))))
                       (unless (find-method gf nil specializers nil)
                         (let ((method method))
                           (add-method gf
                             (make-instance (sb-mop:generic-function-method-class gf)
                               :qualifiers nil :lambda-list (cons 'this (loop for i below count collect (gensym "ARG")))
                               :specializers specializers
                               :function (lambda (args next)
                                           (declare (ignore next))
                                           (%verify-class-for-java class)
                                           (%jni-call-native class method (first args) (rest args))))))))))))))

(defun %jni-check-save ()
  "External libraries may own arbitrary C state, which an SBCL core cannot save."
  (when *jni-libraries*
    (error "Cannot save an image with loaded JNI libraries; load them after image restart")))

(defun %jni-reset-for-save ()
  (%jni-check-save)
  (clrhash *jni-references*)
  (clrhash *jni-members*)
  (clrhash *jni-member-ids*)
  (clrhash *jni-states*)
  (clrhash *jni-bindings*)
  (setf *jni-loaded* nil *jni-counter* 0
        *jni-lock* (bordeaux-threads:make-recursive-lock "JNI libraries and handles")))

(pushnew '%jni-reset-for-save sb-ext:*save-hooks*)
