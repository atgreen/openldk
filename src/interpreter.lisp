;;; -*- Mode: LISP; Syntax: COMMON-LISP; Package: OPENLDK; Base: 10 -*-
;;; SPDX-License-Identifier: GPL-3.0-or-later WITH Classpath-exception-2.0
;;;
;;; A baseline execution path for a verified method reentered while its JIT
;;; compilation is resolving classes. In particular, class-loading callbacks
;;; must be executable before the outer compilation has finished linking.

(in-package :openldk)

(defvar *interpreter-instructions* (make-hash-table :test #'eq :weakness :key :synchronized t)
  "Decoded instructions for methods executed by the reentrant fallback.")

(defun %interpreter-class (name loader)
  "Resolve NAME through LOADER only when its instruction actually executes."
  (or (if (starts-with? "[" name)
          (let ((*descriptor-loader* (and loader (java-loader loader))))
            (%get-array-ldk-class-from-name name))
          (%resolve-class name loader))
      (%throw '|java/lang/NoClassDefFoundError| name)))

(defun %interpreter-field (class name descriptor)
  "Return the declaring class and field metadata for a symbolic field."
  (loop for owner = class then (and (super owner)
                                    (%interpreter-class (super owner) (ldk-loader owner)))
        while owner
        for field = (find-if (lambda (field) (and (string= (name field) name)
                                                 (string= (descriptor field) descriptor)))
                             (fields owner))
        when field return (values owner field)
        finally (%throw '|java/lang/NoSuchFieldError| name)))

(defun %interpreter-signed (value bits)
  "Narrow VALUE to a signed BITS-bit Java integer."
  (let ((unsigned (logand value (1- (ash 1 bits)))))
    (if (logbitp (1- bits) unsigned) (- unsigned (ash 1 bits)) unsigned)))

(defun %interpreter-number (value type)
  "Normalize a numeric result to its declared JVM category."
  (case type
    (:int (%as-int value)) (:long (%as-long value))
    (:float (float value 1.0f0)) (:double (float value 1.0d0))
    (t value)))

(defun %interpreter-call (owner name descriptor arguments receiver opcode loader)
  "Invoke a symbolic method while preserving its defining loader and call kind."
  (let* ((class (%interpreter-class owner loader))
         (method-name (lispize-method-name (concatenate 'string name descriptor)))
         (symbol (intern method-name :openldk)))
    (case opcode
      (184
       (let* ((target (or (%find-declaring-class class method-name) class))
              (function (static-method-symbol (format nil "~A.~A" (name target) method-name)
                                               (ldk-class-package target))))
         (%clinit target)
         (apply function arguments)))
      (183
       (unless receiver (%throw '|java/lang/NullPointerException|))
       (invoke-special symbol (intern (name class) (ldk-class-package class))
                       (cons receiver arguments)))
      (t
       (unless receiver (%throw '|java/lang/NullPointerException|))
       (apply symbol receiver arguments)))))

(defun %execute-verified-bytecode (class method-index receiver arguments)
  "Execute an already verified method during reentrant compilation.
This path resolves symbolic references as their bytecodes execute, so a
class-loading callback may return before reaching references that caused the
outer JIT to reenter it. Unsupported instructions fail explicitly."
  (when (stringp class) (setf class (%get-ldk-class-by-bin-name class)))
  (assert (verified-p class))
  (let* ((method (aref (methods class) (1- method-index)))
         (attribute (gethash "Code" (attributes method)))
         (bytes (slot-value attribute 'code))
         (instructions (or (gethash method *interpreter-instructions*)
                           (setf (gethash method *interpreter-instructions*) (%v-decode class method))))
         (pool (constant-pool class))
         (loader (ldk-loader class))
         (locals (make-array (slot-value attribute 'max-locals) :initial-element nil))
         (stack nil) (pc 0) (held-monitors nil)
         (method-monitor (and (synchronized-p method) (if (static-p method) (java-class class) receiver))))
    (labels ((put (value type) (push (cons value type) stack))
             (take-value () (car (pop stack)))
             (group (width)
               (loop with result = nil with slots = 0
                     while (< slots width)
                     for cell = (pop stack)
                     do (incf slots (%v-width (cdr cell))) (push cell result)
                     finally (assert (= slots width)) (return (nreverse result))))
             (constant (index)
               (let* ((entry (aref pool index)) (type (%v-ldc-type pool index)))
                 (put (typecase entry
                        (constant-value (value entry))
                        (constant-string-reference (ijstring (%v-utf pool (slot-value entry 'index))))
                        (constant-class-reference (java-class (%interpreter-class (%v-class-name pool index) loader)))
                        (t (internal-error "Reentrant ldc constant ~S" (type-of entry)))) type)))
             (branch (truth instruction)
               (when truth (setf pc (first (vi-targets instruction)))))
             (comparison (index left right)
               (funcall (nth index (list #'= #'/= #'< #'>= #'> #'<=)) left right))
             (field (opcode index)
               (%check-member-loader-constraints class index)
               (multiple-value-bind (owner field-name descriptor) (%v-member pool index 'constant-field-reference)
                 (multiple-value-bind (declaring field)
                     (%interpreter-field (%interpreter-class owner loader) field-name descriptor)
                   (let* ((write (member opcode '(179 181)))
                          (value (when write (take-value)))
                          (static (member opcode '(178 179)))
                          (object (if static
                                      (progn
                                        (%clinit declaring)
                                        (symbol-value (intern (format nil "+static-~A+" (name declaring))
                                                              (ldk-class-package declaring))))
                                      (take-value)))
                          (slot (%field-slot-symbol declaring field (ldk-loader declaring)))
                          (volatile (logtest #x40 (access-flags field))))
                     (unless object (%throw '|java/lang/NullPointerException|))
                     (when volatile (sb-thread:barrier (:memory)))
                     (if write
                         (setf (slot-value object slot)
                               (case (char descriptor 0)
                                 (#\B (%interpreter-signed value 8))
                                 (#\S (%interpreter-signed value 16))
                                 (#\C (logand value #xffff))
                                 (#\Z (logand value 1))
                                 (t value)))
                         (put (slot-value object slot) (%v-field-type descriptor)))
                     (when volatile (sb-thread:barrier (:memory)))))))
             (invoke-member (opcode index)
               (%check-member-loader-constraints class index)
               (multiple-value-bind (owner method-name descriptor)
                   (%v-member pool index '(or constant-method-reference constant-interface-method-reference))
                 (multiple-value-bind (parameters result-type) (%v-method-types descriptor)
                   (let* ((args (nreverse (loop repeat (length parameters) collect (take-value))))
                          (object (unless (= opcode 184) (take-value)))
                          (result (%interpreter-call owner method-name descriptor args object opcode loader)))
                     (unless (eq result-type :void) (put result result-type))))))
             (dispatch (instruction)
               (let* ((position (vi-pc instruction)) (opcode (aref bytes position))
                      (operands (vi-operands instruction)) (operand (first operands)))
                 (cond
                   ((= opcode 0))
                   ((= opcode 1) (put nil :reference))
                   ((<= 2 opcode 8) (put (- opcode 3) :int))
                   ((<= 9 opcode 10) (put (- opcode 9) :long))
                   ((<= 11 opcode 13) (put (float (- opcode 11) 1.0f0) :float))
                   ((<= 14 opcode 15) (put (float (- opcode 14) 1.0d0) :double))
                   ((= opcode 16) (put (%interpreter-signed operand 8) :int))
                   ((= opcode 17) (put (%interpreter-signed operand 16) :int))
                   ((<= 18 opcode 20) (constant operand))
                   ((<= 21 opcode 25) (push (aref locals operand) stack))
                   ((<= 26 opcode 45) (push (aref locals (mod (- opcode 26) 4)) stack))
                   ((<= 46 opcode 53)
                    (let* ((index (take-value)) (array (take-value)))
                      (unless array (%throw '|java/lang/NullPointerException|))
                      (put (jaref array index) (aref #(:int :long :float :double :reference :int :int :int) (- opcode 46)))))
                   ((<= 54 opcode 58) (setf (aref locals operand) (pop stack)))
                   ((<= 59 opcode 78) (setf (aref locals (mod (- opcode 59) 4)) (pop stack)))
                   ((<= 79 opcode 86)
                    (let* ((value (take-value)) (index (take-value)) (array (take-value)))
                      (unless array (%throw '|java/lang/NullPointerException|))
                      (if (= opcode 83) (%aastore array index value) (setf (jaref array index) value))))
                   ((= opcode 87) (pop stack))
                   ((= opcode 88) (group 2))
                   ((<= 89 opcode 94)
                    (let* ((top (group (if (<= opcode 91) 1 2)))
                           (below (case opcode ((90 93) (group 1)) ((91 94) (group 2)))))
                      (setf stack (append top below top stack))))
                   ((= opcode 95)
                    (let ((first (pop stack)) (second (pop stack)))
                      (setf stack (list* second first stack))))
                   ((<= 96 opcode 115)
                    (let* ((type (aref #(:int :long :float :double) (mod (- opcode 96) 4)))
                           (right (take-value)) (left (take-value))
                           (operation (floor (- opcode 96) 4)))
                      (when (and (member type '(:int :long)) (>= operation 3) (zerop right))
                        (%throw '|java/lang/ArithmeticException| "/ by zero"))
                      (put (%interpreter-number
                            (case operation (0 (+ left right)) (1 (- left right)) (2 (* left right))
                              (3 (if (member type '(:int :long)) (truncate left right) (/ left right)))
                              (4 (rem left right))) type) type)))
                   ((<= 116 opcode 119)
                    (let ((type (aref #(:int :long :float :double) (- opcode 116))))
                      (put (%interpreter-number (- (take-value)) type) type)))
                   ((<= 120 opcode 131)
                    (let* ((type (if (evenp opcode) :int :long))
                           (right (take-value)) (left (take-value))
                           (shift (logand right (if (eq type :int) 31 63)))
                           (operation (floor (- opcode 120) 2)))
                      (put (%interpreter-number
                            (case operation (0 (ash left shift)) (1 (ash left (- shift)))
                              (2 (ash (logand left (if (eq type :int) #xffffffff #xffffffffffffffff)) (- shift)))
                              (3 (logand left right)) (4 (logior left right)) (5 (logxor left right))) type) type)))
                   ((= opcode 132)
                    (setf (aref locals operand)
                          (cons (%as-int (+ (car (aref locals operand)) (%interpreter-signed (second operands) 8))) :int)))
                   ((<= 153 opcode 158) (branch (comparison (- opcode 153) (take-value) 0) instruction))
                   ((<= 159 opcode 164)
                    (let ((right (take-value)) (left (take-value)))
                      (branch (comparison (- opcode 159) left right) instruction)))
                   ((member opcode '(165 166))
                    (let ((same (eq (take-value) (take-value))))
                      (branch (if (= opcode 165) same (not same)) instruction)))
                   ((member opcode '(167 200)) (setf pc (first (vi-targets instruction))))
                   ((<= 172 opcode 176) (return-from %execute-verified-bytecode (take-value)))
                   ((= opcode 177) (return-from %execute-verified-bytecode nil))
                   ((<= 178 opcode 181) (field opcode operand))
                   ((<= 182 opcode 185) (invoke-member opcode operand))
                   ((= opcode 187)
                    (let ((target (%interpreter-class (%v-class-name pool operand) loader)))
                      (%clinit target)
                      (put (make-instance (intern (name target) (ldk-class-package target))) :reference)))
                   ((= opcode 190)
                    (let ((array (take-value)))
                      (unless array (%throw '|java/lang/NullPointerException|))
                      (put (java-array-length array) :int)))
                   ((= opcode 191)
                    (let ((throwable (take-value)))
                      (unless throwable (%throw '|java/lang/NullPointerException|))
                      (error (%lisp-condition throwable))))
                   ((member opcode '(192 193))
                    (let* ((value (take-value))
                           (target (java-class (%interpreter-class (%v-class-name pool operand) loader)))
                           (matches (and value (not (zerop (|isInstance(Ljava/lang/Object;)Z| target value))))))
                      (if (= opcode 193)
                          (put (if matches 1 0) :int)
                          (progn
                            (unless (or (null value) matches) (%throw '|java/lang/ClassCastException|))
                            (put value :reference)))))
                   ((= opcode 194)
                    (let ((object (take-value)))
                      (unless object (%throw '|java/lang/NullPointerException|))
                      (monitor-enter object) (push object held-monitors)))
                   ((= opcode 195)
                    (let ((object (take-value)))
                      (unless object (%throw '|java/lang/NullPointerException|))
                      (monitor-exit object)
                      (setf held-monitors (remove object held-monitors :count 1 :test #'eq))))
                   ((member opcode '(198 199))
                    (let ((null (null (take-value))))
                      (branch (if (= opcode 198) null (not null)) instruction)))
                   (t (internal-error "Reentrant interpreter instruction ~A at ~D in ~A.~A"
                                      (vi-opcode instruction) position (name class) (name method)))))))
      (multiple-value-bind (parameters result) (%v-method-types (descriptor method))
        (declare (ignore result))
        (let ((index 0))
          (unless (static-p method) (setf (aref locals index) (cons receiver :reference)) (incf index))
          (loop for type in parameters for value in arguments
                do (setf (aref locals index) (cons value type)) (incf index (%v-width type)))))
      (when method-monitor (monitor-enter method-monitor))
      (unwind-protect
           (loop while (< pc (length bytes))
                 for instruction = (aref instructions pc)
                 for position = pc
                 do (setf pc (+ position (vi-size instruction)))
                    (handler-case
                        (with-java-conditions (:arrays t) (dispatch instruction))
                      (|condition-java/lang/Throwable| (condition)
                        (let* ((throwable (slot-value condition '|objref|))
                               (handler (find-if
                                         (lambda (entry)
                                           (and (<= (slot-value entry 'start-pc) position)
                                                (< position (slot-value entry 'end-pc))
                                                (or (null (slot-value entry 'catch-type))
                                                    (not (zerop (|isInstance(Ljava/lang/Object;)Z|
                                                                  (java-class (%interpreter-class (slot-value entry 'catch-type) loader))
                                                                  throwable))))))
                                         (slot-value attribute 'exceptions))))
                          (unless handler (error condition))
                          (setf pc (slot-value handler 'handler-pc) stack (list (cons throwable :reference))))))
                 finally (internal-error "Reentrant interpreter fell off method ~A" (name method)))
        (dolist (object held-monitors) (monitor-exit object))
        (when method-monitor (monitor-exit method-monitor))))))
