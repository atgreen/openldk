(in-package :openldk)

;;; Verification uses its own type states, never the optimizing compiler's IR.
;;; Reference types are binary class names or array descriptors; primitive
;;; verification types are keywords. A category-2 stack value is one entry,
;;; while its second local-variable slot is represented explicitly by :SECOND.

(defstruct (verification-instruction (:conc-name vi-))
  pc opcode size operands targets (fall-through-p t))

(defun %v-cp (pool index type)
  "A checked constant-pool lookup, including rejection of wide-constant holes."
  (unless (and (integerp index) (< 0 index (length pool))
               (typep (aref pool index) type))
    (verification-error "Invalid constant-pool index/tag ~D (expected ~S)" index type))
  (aref pool index))

(defun %v-utf (pool index)
  "Read a CONSTANT_Utf8 without executing EMIT or resolving a class."
  (slot-value (%v-cp pool index 'ir-string-literal) 'value))

(defun %v-class-name (pool index)
  "The binary name or array descriptor at a checked CONSTANT_Class entry."
  (%v-utf pool (slot-value (%v-cp pool index 'constant-class-reference) 'index)))

(defun %v-member (pool index type)
  "Return the owner, name, and descriptor of a symbolic member reference."
  (let* ((entry (%v-cp pool index type))
         (nat (%v-cp pool (if (typep entry 'constant-field-reference)
                             (slot-value entry 'name-and-type-descriptor-index)
                             (slot-value entry 'method-descriptor-index))
                     'constant-name-and-type-descriptor)))
    (values (%v-class-name pool (slot-value entry 'class-index))
            (%v-utf pool (slot-value nat 'name-index))
            (%v-utf pool (slot-value nat 'type-descriptor-index)))))

(defun %v-descriptor-type (descriptor start &optional void-p)
  "Parse one field/return type; return its verification type and next index."
  (let ((end (length descriptor)))
    (unless (< start end) (class-format-error "Truncated descriptor ~S" descriptor))
    (let ((ch (char descriptor start)))
      (case ch
        ((#\B #\C #\I #\S #\Z) (values :int (1+ start)))
        (#\F (values :float (1+ start)))
        (#\J (values :long (1+ start)))
        (#\D (values :double (1+ start)))
        (#\V (if void-p (values :void (1+ start))
                 (class-format-error "Void field/parameter type in ~S" descriptor)))
        (#\L
         (let ((semicolon (position #\; descriptor :start (1+ start))))
           (unless (and semicolon (> semicolon (1+ start)))
             (class-format-error "Malformed reference descriptor ~S" descriptor))
           (let ((name (subseq descriptor (1+ start) semicolon)))
             (when (find-if (lambda (c) (find c ".[;")) name)
               (class-format-error "Malformed reference name in ~S" descriptor))
             (values name (1+ semicolon)))))
        (#\[
         (let ((component start))
           (loop while (and (< component end) (char= (char descriptor component) #\[))
                 do (incf component))
           (when (> (- component start) 255) (class-format-error "Too many array dimensions"))
           (multiple-value-bind (type next) (%v-descriptor-type descriptor component)
             (declare (ignore type))
             (values (subseq descriptor start next) next))))
        (otherwise (class-format-error "Invalid descriptor ~S" descriptor))))))

(defun %v-field-type (descriptor)
  "Parse a complete field descriptor."
  (multiple-value-bind (type end) (%v-descriptor-type descriptor 0)
    (unless (= end (length descriptor)) (class-format-error "Trailing field descriptor data: ~S" descriptor))
    type))

(defun %v-method-types (descriptor)
  "Return method parameters in declaration order and its return type."
  (unless (and (plusp (length descriptor)) (char= (char descriptor 0) #\())
    (class-format-error "Invalid method descriptor ~S" descriptor))
  (let ((pos 1) (parameters nil))
    (loop
      (when (>= pos (length descriptor)) (class-format-error "Truncated method descriptor ~S" descriptor))
      (when (char= (char descriptor pos) #\)) (incf pos) (return))
      (multiple-value-bind (type end) (%v-descriptor-type descriptor pos)
        (push type parameters) (setf pos end)))
    (multiple-value-bind (result end) (%v-descriptor-type descriptor pos t)
      (unless (= end (length descriptor)) (class-format-error "Trailing method descriptor data: ~S" descriptor))
      (values (nreverse parameters) result))))

(defun %v-width (type)
  "JVM slots occupied by a verification value."
  (if (member type '(:long :double)) 2 1))

(defun %v-stack-slots (stack)
  "Operand-stack size in JVM slots rather than logical values."
  (reduce #'+ stack :key #'%v-width :initial-value 0))

(defun %v-decode (class method)
  "Decode and check every instruction, including unreachable bytecodes."
  (let* ((attribute (gethash "Code" (attributes method)))
         (code (slot-value attribute 'code))
         (n (length code)) (pool (constant-pool class))
         (instructions (make-array n :initial-element nil))
         (max-locals (slot-value attribute 'max-locals)))
    (unless (< 0 n 65536) (verification-error "Invalid code length ~D" n))
    (labels ((need (pos count)
               (unless (<= 0 pos (+ pos count) n) (verification-error "Truncated instruction at ~D" pos)))
             (u1 (pos) (need pos 1) (aref code pos))
             (u2 (pos) (+ (ash (u1 pos) 8) (u1 (1+ pos))))
             (s2 (pos) (let ((v (u2 pos))) (if (logbitp 15 v) (- v 65536) v)))
             (s4 (pos)
               (let ((v (+ (ash (u2 pos) 16) (u2 (+ pos 2)))))
                 (if (logbitp 31 v) (- v #x100000000) v)))
             (local (index width)
               (unless (<= 0 index (- max-locals width))
                 (verification-error "Local ~D of width ~D exceeds max_locals ~D" index width max-locals))))
      (loop with pc = 0 while (< pc n)
            for byte = (u1 pc)
            do (unless (< byte (length *opcodes*)) (verification-error "Invalid opcode ~D at ~D" byte pc))
               (let* ((op (aref *opcodes* byte)) (size 1) (args nil) (targets nil) (fall t))
                 (cond
                   ((member byte '(16 18 188)) (setf size 2 args (list (u1 (1+ pc)))))
                   ((member byte '(17 19 20 178 179 180 181 182 183 184 187 189 192 193))
                    (setf size 3 args (list (u2 (1+ pc)))))
                   ((or (<= 21 byte 25) (<= 54 byte 58) (= byte 169))
                    (setf size 2 args (list (u1 (1+ pc))))
                    (local (first args) (if (member byte '(22 24 55 57)) 2 1)))
                   ((<= 26 byte 45)
                    (local (mod (- byte 26) 4) (if (member (floor (- byte 26) 4) '(1 3)) 2 1)))
                   ((<= 59 byte 78)
                    (local (mod (- byte 59) 4) (if (member (floor (- byte 59) 4) '(1 3)) 2 1)))
                   ((= byte 132) (setf size 3 args (list (u1 (1+ pc)) (u1 (+ pc 2)))) (local (first args) 1))
                   ((or (<= 153 byte 168) (member byte '(198 199)))
                    (setf size 3 targets (list (+ pc (s2 (1+ pc))))
                          fall (not (member byte '(167 168)))))
                   ((member byte '(200 201))
                    (setf size 5 targets (list (+ pc (s4 (1+ pc)))) fall nil))
                   ((member byte '(170 171))
                    (let* ((base (+ pc 1 (mod (- (1+ pc)) 4)))
                           (default (+ pc (s4 base))))
                      (loop for pad from (1+ pc) below base
                            unless (zerop (u1 pad)) do (verification-error "Nonzero switch padding at ~D" pc))
                      (setf fall nil)
                      (if (= byte 170)
                          (let* ((low (s4 (+ base 4))) (high (s4 (+ base 8))) (count (1+ (- high low))))
                            (unless (and (<= low high) (<= count (floor (- n base 12) 4)))
                              (verification-error "Invalid tableswitch range at ~D" pc))
                            (setf size (- (+ base 12 (* 4 count)) pc)
                                  targets (cons default (loop for i below count collect (+ pc (s4 (+ base 12 (* i 4))))))))
                          (let ((count (s4 (+ base 4))) (previous nil))
                            (unless (<= 0 count (floor (- n base 8) 8))
                              (verification-error "Invalid lookupswitch size at ~D" pc))
                            (setf size (- (+ base 8 (* 8 count)) pc) targets (list default))
                            (dotimes (i count)
                              (let ((key (s4 (+ base 8 (* i 8)))))
                                (when (and previous (<= key previous))
                                  (verification-error "Unsorted lookupswitch keys at ~D" pc))
                                (setf previous key)
                                (push (+ pc (s4 (+ base 12 (* i 8)))) targets)))))))
                   ((member byte '(185 186))
                    (setf size 5 args (list (u2 (1+ pc)) (u1 (+ pc 3)) (u1 (+ pc 4))))
                    (unless (and (zerop (third args)) (or (= byte 185) (zerop (second args))))
                      (verification-error "Invalid reserved invoke operand at ~D" pc)))
                   ((= byte 196)
                    (let ((nested (u1 (1+ pc))) (index (u2 (+ pc 2))))
                      (unless (or (<= 21 nested 25) (<= 54 nested 58) (member nested '(132 169)))
                        (verification-error "Invalid wide opcode at ~D" pc))
                      (setf size (if (= nested 132) 6 4) args (list nested index))
                      (local index (if (member nested '(22 24 55 57)) 2 1))))
                   ((= byte 197) (setf size 4 args (list (u2 (1+ pc)) (u1 (+ pc 3))))))
                 (need pc size)
                 (when (member byte '(169 172 173 174 175 176 177 191)) (setf fall nil))
                 (when (and (>= (major-version class) 50)
                            (or (member byte '(168 169 201)) (and (= byte 196) (= (first args) 169))))
                   (verification-error "jsr/ret is not permitted by the modern verifier"))
                 (when (and (= byte 188) (not (<= 4 (first args) 11)))
                   (verification-error "Invalid newarray type at ~D" pc))
                 (case byte
                   ((18 19 20)
                    (let* ((entry (%v-cp pool (first args)
                                        '(or constant-int constant-float constant-long constant-double
                                             constant-string-reference constant-class-reference
                                             constant-method-type constant-method-handle constant-dynamic)))
                           (wide (or (typep entry '(or constant-long constant-double))
                                     (and (typep entry 'constant-dynamic)
                                          (member (%v-dynamic-type pool entry) '(:long :double))))))
                      (unless (eql (= byte 20) (not (null wide)))
                        (verification-error "Wrong ldc category at ~D" pc))))
                   ((178 179 180 181) (%v-member pool (first args) 'constant-field-reference))
                   (182 (%v-member pool (first args) '(and constant-method-reference (not constant-interface-method-reference))))
                   ((183 184) (%v-member pool (first args)
                                         (if (>= (major-version class) 52) 'constant-method-reference
                                             '(and constant-method-reference (not constant-interface-method-reference)))))
                   (185
                    (multiple-value-bind (owner name descriptor)
                        (%v-member pool (first args) 'constant-interface-method-reference)
                      (declare (ignore owner name))
                      (unless (= (second args) (1+ (%v-stack-slots (%v-method-types descriptor))))
                        (verification-error "Invalid invokeinterface argument count at ~D" pc))))
                   (186 (%v-dynamic-type pool (%v-cp pool (first args) 'constant-invoke-dynamic) t))
                   ((187 189 192 193 197)
                    (let ((name (%v-class-name pool (first args))))
                      (when (and (= byte 187) (char= (char name 0) #\[))
                        (verification-error "new cannot allocate an array"))
                      (when (= byte 197)
                        (unless (and (plusp (second args))
                                     (<= (second args) (or (position-if-not (lambda (ch) (char= ch #\[)) name) 0)))
                          (verification-error "Invalid multianewarray dimensions at ~D" pc))))))
                 (setf (aref instructions pc)
                       (make-verification-instruction :pc pc :opcode op :size size :operands args
                                                      :targets targets :fall-through-p fall))
                 (incf pc size)))
      (loop for insn across instructions when insn
            do (dolist (target (vi-targets insn))
                 (unless (and (<= 0 target) (< target n) (aref instructions target))
                   (verification-error "Branch at ~D targets non-instruction ~D" (vi-pc insn) target))))
      (loop for handler across (or (slot-value attribute 'exceptions) #())
            for start = (start-pc handler) for end = (end-pc handler) for target = (handler-pc handler)
            do (unless (and (<= 0 start) (< start end) (<= end n) (aref instructions start)
                            (or (= end n) (aref instructions end))
                            (<= 0 target) (< target n) (aref instructions target))
                 (verification-error "Invalid exception table entry ~A" handler))))
    instructions))

(defun %v-dynamic-type (pool entry &optional method-p)
  "Read the descriptor of a dynamic constant or invokedynamic call site."
  (let* ((nat (%v-cp pool (slot-value entry 'name-and-type-index) 'constant-name-and-type-descriptor))
         (descriptor (%v-utf pool (slot-value nat 'type-descriptor-index))))
    (if method-p (%v-method-types descriptor) (%v-field-type descriptor))))

(defun verify-class-structure (class)
  "Validate method descriptors, Code presence, and bytecode operand structure."
  (%v-check-pool class)
  (loop for field across (fields class) do (%v-field-type (descriptor field)))
  (loop for method across (methods class)
        for code = (gethash "Code" (attributes method))
        do (multiple-value-bind (parameters result) (%v-method-types (descriptor method))
             (let ((slots (+ (if (static-p method) 0 1) (%v-stack-slots parameters))))
               (when (> slots 255) (class-format-error "Method parameters exceed 255 slots"))
               (when (and code (> slots (slot-value code 'max-locals)))
                 (class-format-error "Parameters exceed max_locals for ~A" method)))
             (when (and (string= (name method) "<init>") (or (static-p method) (not (eql result :void))))
               (class-format-error "Invalid constructor descriptor/flags"))
             (when (and (string= (name method) "<clinit>")
                        (or (not (string= (descriptor method) "()V"))
                            (and (>= (major-version class) 51) (not (static-p method)))))
               (class-format-error "Invalid class initializer descriptor/flags")))
           (unless (eql (not (null code)) (not (or (native-p method) (abstract-p method))))
             (class-format-error "Invalid Code attribute presence for ~A" method))
           (when code (%v-decode class method)))
  t)

(defun %v-self-name (class)
  "Use the original symbolic name inside a hidden/anonymous class's bytecodes."
  (or (verification-name class) (name class)))

(defun %v-reference-p (type)
  "True for initialized reference verification types, including null."
  (or (stringp type) (eql type :null)))

(defun %v-uninitialized-p (type)
  "True for uninitializedThis or the allocation-site identity of a new object."
  (or (eql type :uninitialized-this) (and (consp type) (eql (first type) :uninitialized))))

(defun %v-array-component (type)
  "The component of an array descriptor, preserving narrow primitive types."
  (when (and (stringp type) (plusp (length type)) (char= (char type 0) #\[))
    (let ((tail (subseq type 1)))
      (if (find (char tail 0) "BCDFIJSZ")
          (char tail 0)
          (%v-field-type tail)))))

(defun %v-find-class (name class)
  "Resolve verification hierarchy metadata through CLASS's defining loader."
  (if (string= name (%v-self-name class)) class
      (let ((loader (and (slot-boundp class 'ldk-loader) (ldk-loader class))))
        (or (%get-ldk-class-by-bin-name name t loader)
            (%resolve-class name loader)))))

(defun %v-assignable-p (actual expected class)
  "The JVM verifier's assignment relation (interfaces are checked at run time)."
  (cond
    ((or (equal actual expected) (eql expected :top)) t)
    ((and (eql actual :null) (stringp expected)) t)
    ((and (stringp actual) (stringp expected))
     (cond
       ((string= expected "java/lang/Object") t)
       ((%v-array-component actual)
        (cond
          ((member expected '("java/lang/Cloneable" "java/io/Serializable") :test #'string=) t)
          ((%v-array-component expected)
           (let ((a (%v-array-component actual)) (b (%v-array-component expected)))
             (if (or (characterp a) (characterp b)) (eql a b)
                 (%v-assignable-p a b class))))))
       ((%v-array-component expected) nil)
       (t
        (let ((target (%v-find-class expected class)))
          (or (and target (interface-p target))
              (loop with seen = nil
                    for current = (%v-find-class actual class)
                      ;; A superclass name belongs to the defining class's
                      ;; constant pool. OSGi importers need not see that
                      ;; defining loader's other imported packages.
                      then (and (super current) (%v-find-class (super current) current))
                    while current
                    when (eq current target) return t
                    when (member current seen) return nil
                    do (push current seen)))))))
    (t nil)))

(defun %v-initial-types (class method)
  "The logical initial locals, before category-2 expansion."
  (append (unless (static-p method)
            (list (if (and (string= (name method) "<init>") (super class))
                      :uninitialized-this (%v-self-name class))))
          (%v-method-types (descriptor method))))

(defun %v-expand-locals (types maximum)
  "Expand logical stack-map locals to MAXIMUM physical slots."
  (let ((locals (make-array maximum :initial-element :top)) (index 0))
    (dolist (type types)
      (when (> (+ index (%v-width type)) maximum)
        (verification-error "Stack-map locals exceed max_locals"))
      (setf (aref locals index) type)
      (incf index)
      (when (= (%v-width type) 2)
        (setf (aref locals index) :second)
        (incf index)))
    locals))

(defun %v-stack-maps (class method instructions)
  "Decode every StackMapTable frame without trusting its counts or offsets."
  (let* ((attribute (gethash "Code" (attributes method)))
         (bytes (gethash "StackMapTable" (slot-value attribute 'attributes)))
         (frames (make-hash-table)) (pos 0) (offset -1)
         (locals (%v-initial-types class method))
         (maximum (slot-value attribute 'max-locals))
         (pool (constant-pool class)))
    (labels ((u1 ()
               (unless (< pos (length bytes)) (class-format-error "Truncated StackMapTable"))
               (prog1 (aref bytes pos) (incf pos)))
             (u2 () (+ (ash (u1) 8) (u1)))
             (vtype ()
               (case (u1)
                 (0 :top) (1 :int) (2 :float) (3 :double) (4 :long) (5 :null)
                 (6 (unless (and (string= (name method) "<init>") (super class))
                      (verification-error "uninitializedThis outside an initializing constructor"))
                    :uninitialized-this)
                 (7 (%v-class-name pool (u2)))
                 (8 (let ((pc (u2)))
                      (unless (and (< pc (length instructions)) (aref instructions pc)
                                   (eql (vi-opcode (aref instructions pc)) :new))
                        (verification-error "Stack-map uninitialized offset does not identify new"))
                      (list :uninitialized pc
                            (%v-class-name pool (first (vi-operands (aref instructions pc)))))))
                 (otherwise (class-format-error "Invalid verification_type_info tag")))))
      (when bytes
        (let ((count (u2)))
          (dotimes (i count)
            (let ((tag (u1)) (delta 0) (stack nil))
              (cond
                ((<= tag 63) (setf delta tag))
                ((<= tag 127) (setf delta (- tag 64) stack (list (vtype))))
                ((= tag 247) (setf delta (u2) stack (list (vtype))))
                ((<= 248 tag 250)
                 (setf delta (u2))
                 (let ((keep (- (length locals) (- 251 tag))))
                   (when (minusp keep) (class-format-error "Stack-map chop underflow"))
                   (setf locals (subseq locals 0 keep))))
                ((= tag 251) (setf delta (u2)))
                ((<= 252 tag 254)
                 (setf delta (u2) locals (append locals (loop repeat (- tag 251) collect (vtype)))))
                ((= tag 255)
                 (setf delta (u2) locals (loop repeat (u2) collect (vtype))
                       stack (loop repeat (u2) collect (vtype))))
                (t (class-format-error "Reserved stack-map frame tag ~D" tag)))
              (incf offset (1+ delta))
              (unless (and (< offset (length instructions)) (aref instructions offset))
                (verification-error "Stack-map frame at non-instruction ~D" offset))
              (when (or (member :top stack) (> (%v-stack-slots stack) (slot-value attribute 'max-stack)))
                (verification-error "Invalid stack-map operand stack at ~D" offset))
              ;; Each frame carries its constructor flag independently of locals
              ;; used during instruction execution; erasing local 0 cannot permit return.
              (setf (gethash offset frames)
                    (list (%v-expand-locals locals maximum) (reverse stack)
                          (not (null (member :uninitialized-this locals))))))))
        (unless (= pos (length bytes)) (class-format-error "Trailing StackMapTable bytes"))))
    frames))

(defun %v-ldc-type (pool index)
  "The verification type produced by an ldc constant."
  (let ((entry (aref pool index)))
    (typecase entry
      (constant-int :int) (constant-float :float) (constant-long :long) (constant-double :double)
      (constant-string-reference "java/lang/String") (constant-class-reference "java/lang/Class")
      (constant-method-type "java/lang/invoke/MethodType")
      (constant-method-handle "java/lang/invoke/MethodHandle")
      (constant-dynamic (%v-dynamic-type pool entry)))))

(defun %v-step (class method instruction input-locals input-stack input-uninitialized)
  "Check an instruction and return its normal and exceptional type states."
  (let* ((locals (copy-seq input-locals)) (stack (copy-list input-stack))
         (uninitialized input-uninitialized) (exception-locals input-locals)
         (op (vi-opcode instruction)) (args (vi-operands instruction))
         (byte (position op *opcodes*)) (pool (constant-pool class))
         (attribute (gethash "Code" (attributes method)))
         (result (nth-value 1 (%v-method-types (descriptor method)))))
    (labels ((pop-value ()
               (unless stack (verification-error "Operand stack underflow"))
               (pop stack))
             (take-type (expected)
               (let ((actual (pop-value)))
                 (unless (%v-assignable-p actual expected class)
                   (verification-error "Expected ~S on stack, found ~S" expected actual))
                 actual))
             (reference ()
               (let ((actual (pop-value)))
                 (unless (%v-reference-p actual) (verification-error "Expected initialized reference, found ~S" actual))
                 actual))
             (category-one ()
               (let ((actual (pop-value)))
                 (unless (and (= (%v-width actual) 1) (not (member actual '(:top :second))))
                   (verification-error "Expected category-1 stack value"))
                 actual))
             (load-local (index type)
               (let ((actual (aref locals index)))
                 (unless (if (eql type :reference)
                             (or (%v-reference-p actual) (%v-uninitialized-p actual))
                             (and (eql type actual)
                                  (or (= (%v-width type) 1) (eql (aref locals (1+ index)) :second))))
                   (verification-error "Invalid local ~D: expected ~S, found ~S" index type actual))
                 (push actual stack)))
             (store-local (index type)
               (let ((actual (pop-value)))
                 (unless (if (eql type :reference)
                             (or (%v-reference-p actual) (%v-uninitialized-p actual))
                             (eql actual type))
                   (verification-error "Invalid local store: expected ~S, found ~S" type actual))
                 (when (and (plusp index) (eql (aref locals index) :second))
                   (setf (aref locals (1- index)) :top))
                 (when (member (aref locals index) '(:long :double))
                   (setf (aref locals (1+ index)) :top))
                 (setf (aref locals index) actual)
                 (when (= (%v-width actual) 2)
                   (when (member (aref locals (1+ index)) '(:long :double))
                     (setf (aref locals (+ index 2)) :top))
                   (setf (aref locals (1+ index)) :second))))
             (array-value (component)
               (take-type :int)
               (let ((array (reference)))
                 (unless (or (eql array :null)
                             (if (eql component :reference)
                                 (stringp (%v-array-component array))
                                 (member (%v-array-component array) component)))
                   (verification-error "Wrong array type ~S" array))
                 array))
             (initialize-object (old new)
               (setf stack (substitute new old stack :test #'equal))
               (dotimes (i (length locals))
                 (when (equal (aref locals i) old) (setf (aref locals i) new))))
             (binary (type)
               (take-type type) (take-type type) (push type stack)))
      (cond
        ((= byte 0))
        ((= byte 1) (push :null stack))
        ((or (<= 2 byte 8) (member byte '(16 17))) (push :int stack))
        ((<= 9 byte 10) (push :long stack))
        ((<= 11 byte 13) (push :float stack))
        ((<= 14 byte 15) (push :double stack))
        ((member byte '(18 19 20)) (push (%v-ldc-type pool (first args)) stack))
        ((<= 21 byte 25) (load-local (first args) (nth (- byte 21) '(:int :long :float :double :reference))))
        ((<= 26 byte 45) (load-local (mod (- byte 26) 4) (nth (floor (- byte 26) 4) '(:int :long :float :double :reference))))
        ((<= 46 byte 53)
         (let* ((kind (- byte 46))
                (array (array-value (nth kind '((#\I) (#\J) (#\F) (#\D) :reference (#\B #\Z) (#\C) (#\S))))))
           (push (if (= kind 4) (if (eql array :null) :null (%v-array-component array))
                     (nth kind '(:int :long :float :double nil :int :int :int))) stack)))
        ((<= 54 byte 58) (store-local (first args) (nth (- byte 54) '(:int :long :float :double :reference))))
        ((<= 59 byte 78) (store-local (mod (- byte 59) 4) (nth (floor (- byte 59) 4) '(:int :long :float :double :reference))))
        ((<= 79 byte 86)
         (let ((kind (- byte 79)))
           (if (= kind 4) (reference) (take-type (nth kind '(:int :long :float :double nil :int :int :int))))
           ;; aastore checks array covariance at run time, as required by the JVM.
           (array-value (nth kind '((#\I) (#\J) (#\F) (#\D) :reference (#\B #\Z) (#\C) (#\S))))))
        ((= byte 87) (category-one))
        ((= byte 88) (let ((a (pop-value))) (when (= (%v-width a) 1) (category-one))))
        ((= byte 89) (let ((a (category-one))) (setf stack (list* a a stack))))
        ((= byte 90) (let ((a (category-one)) (b (category-one))) (setf stack (list* a b a stack))))
        ((= byte 91)
         (let ((a (category-one)) (b (pop-value)))
           (if (= (%v-width b) 2) (setf stack (list* a b a stack))
               (let ((c (category-one))) (setf stack (list* a b c a stack))))))
        ((= byte 92)
         (let ((a (pop-value)))
           (if (= (%v-width a) 2) (setf stack (list* a a stack))
               (let ((b (category-one))) (setf stack (list* a b a b stack))))))
        ((= byte 93)
         (let ((a (pop-value)))
           (if (= (%v-width a) 2)
               (let ((b (category-one))) (setf stack (list* a b a stack)))
               (let ((b (category-one)) (c (category-one))) (setf stack (list* a b c a b stack))))))
        ((= byte 94)
         (let* ((a (pop-value)) (top (if (= (%v-width a) 2) (list a) (list a (category-one)))))
           (let* ((b (pop-value)) (below (if (= (%v-width b) 2) (list b) (list b (category-one)))))
             (setf stack (append top below top stack)))))
        ((= byte 95) (let ((a (category-one)) (b (category-one))) (setf stack (list* b a stack))))
        ((<= 96 byte 115) (binary (nth (mod (- byte 96) 4) '(:int :long :float :double))))
        ((<= 116 byte 119) (let ((type (nth (- byte 116) '(:int :long :float :double)))) (take-type type) (push type stack)))
        ((<= 120 byte 125)
         (let ((type (if (evenp byte) :int :long))) (take-type :int) (take-type type) (push type stack)))
        ((<= 126 byte 131) (binary (if (evenp byte) :int :long)))
        ((= byte 132) (unless (eql (aref locals (first args)) :int) (verification-error "iinc of non-int local")))
        ((<= 133 byte 147)
         (let ((from (nth (- byte 133) '(:int :int :int :long :long :long :float :float :float :double :double :double :int :int :int)))
               (to (nth (- byte 133) '(:long :float :double :int :float :double :int :long :double :int :long :float :int :int :int))))
           (take-type from) (push to stack)))
        ((<= 148 byte 152)
         (let ((type (cond ((= byte 148) :long) ((<= byte 150) :float) (t :double))))
           (take-type type) (take-type type) (push :int stack)))
        ((<= 153 byte 158) (take-type :int))
        ((<= 159 byte 164) (take-type :int) (take-type :int))
        ((member byte '(165 166)) (reference) (reference))
        ((member byte '(167 200)))
        ((<= 170 byte 171) (take-type :int))
        ((<= 172 byte 176)
         (let ((type (nth (- byte 172) '(:int :long :float :double :reference))))
           (if (eql type :reference)
               (unless (stringp result) (verification-error "areturn in non-reference method"))
               (unless (eql type result) (verification-error "Wrong return opcode for ~S" result)))
           (take-type result)
           (when uninitialized (verification-error "Constructor returns before this is initialized"))))
        ((= byte 177)
         (unless (eql result :void) (verification-error "return in non-void method"))
         (when uninitialized (verification-error "Constructor returns before this is initialized")))
        ((<= 178 byte 181)
         (multiple-value-bind (owner field descriptor) (%v-member pool (first args) 'constant-field-reference)
           (let ((type (%v-field-type descriptor)))
             (when (member byte '(179 181)) (take-type type))
             (when (member byte '(180 181))
               (let ((receiver (pop-value)))
                 (unless (or (%v-assignable-p receiver owner class)
                             (and (= byte 181) (eql receiver :uninitialized-this) (string= owner (%v-self-name class))
                                  (find-if (lambda (f) (and (string= (name f) field) (string= (descriptor f) descriptor)))
                                           (fields class))))
                   (verification-error "Invalid field receiver ~S for ~A" receiver owner))))
             (when (member byte '(178 180)) (push type stack)))))
        ((<= 182 byte 186)
         (multiple-value-bind (owner method-name descriptor)
             (if (= byte 186)
                 (let* ((dynamic (aref pool (first args)))
                        (nat (%v-cp pool (slot-value dynamic 'name-and-type-index) 'constant-name-and-type-descriptor)))
                   (values nil (%v-utf pool (slot-value nat 'name-index)) (%v-utf pool (slot-value nat 'type-descriptor-index))))
                 (%v-member pool (first args) 'constant-method-reference))
           (multiple-value-bind (parameters returns) (%v-method-types descriptor)
             (dolist (type (reverse parameters)) (take-type type))
             (when (string= method-name "<clinit>") (verification-error "Explicit invocation of <clinit>"))
             (cond
               ((string= method-name "<init>")
                (unless (and (= byte 183) (eql returns :void)) (verification-error "Invalid constructor invocation"))
                (let* ((receiver (pop-value))
                       (this-p (eql receiver :uninitialized-this))
                       (target (cond (this-p (%v-self-name class))
                                     ((and (consp receiver) (eql (first receiver) :uninitialized)) (third receiver)))))
                  (unless (and target (if this-p (or (string= owner (%v-self-name class)) (equal owner (super class)))
                                         (string= owner target)))
                    (verification-error "Constructor receiver is not the matching uninitialized object"))
                  (setf exception-locals (copy-seq input-locals))
                  (dotimes (i (length exception-locals))
                    (when (equal (aref exception-locals i) receiver) (setf (aref exception-locals i) :top)))
                  (initialize-object receiver target)
                  (when this-p (setf uninitialized nil))))
               ((member byte '(182 183 185)) (take-type owner)))
             (unless (eql returns :void) (push returns stack)))))
        ((= byte 187)
         (let ((token (list :uninitialized (vi-pc instruction) (%v-class-name pool (first args)))))
           (when (member token stack :test #'equal)
             (verification-error "Allocation-site uninitialized value remains on stack at new"))
           (dotimes (i (length locals))
             (when (equal (aref locals i) token) (setf (aref locals i) :top)))
           (push token stack)))
        ((= byte 188) (take-type :int) (push (nth (- (first args) 4) '("[Z" "[C" "[F" "[D" "[B" "[S" "[I" "[J")) stack))
        ((= byte 189)
         (take-type :int)
         (let ((component (%v-class-name pool (first args))))
           (push (if (char= (char component 0) #\[) (concatenate 'string "[" component)
                     (concatenate 'string "[L" component ";")) stack)))
        ((= byte 190)
         (let ((array (reference)))
           (unless (or (eql array :null) (%v-array-component array)) (verification-error "arraylength of non-array")))
         (push :int stack))
        ((= byte 191) (take-type "java/lang/Throwable"))
        ((= byte 192) (reference) (push (%v-class-name pool (first args)) stack))
        ((= byte 193) (reference) (push :int stack))
        ((member byte '(194 195 198 199)) (reference))
        ((= byte 196)
         (let ((nested (first args)) (index (second args)))
           (cond ((<= 21 nested 25) (load-local index (nth (- nested 21) '(:int :long :float :double :reference))))
                 ((<= 54 nested 58) (store-local index (nth (- nested 54) '(:int :long :float :double :reference))))
                 ((= nested 132) (unless (eql (aref locals index) :int) (verification-error "wide iinc of non-int")))
                 (t (verification-error "Legacy ret has no modern type rule")))))
        ((= byte 197) (dotimes (i (second args)) (take-type :int)) (push (%v-class-name pool (first args)) stack))
        (t (verification-error "No verification rule for ~A" op)))
      (when (> (%v-stack-slots stack) (slot-value attribute 'max-stack))
        (verification-error "Operand stack exceeds max_stack"))
      (values locals stack uninitialized exception-locals))))

(defun verify-method-bytecode (class method)
  "Check modern bytecode against stack maps before any IR or cached code is used.
Pre-50 classfiles currently receive structural checks only; legacy subroutine
inference is deliberately outside this pass."
  (unless (or (verified-p method) (null (gethash "Code" (attributes method))))
    (when (>= (major-version class) 50)
      (let* ((attribute (gethash "Code" (attributes method)))
             (instructions (%v-decode class method))
             (n (length instructions))
             (frames (%v-stack-maps class method instructions))
             (states (make-hash-table)) (work nil)
             (initial (%v-expand-locals (%v-initial-types class method) (slot-value attribute 'max-locals)))
             (initial-flag (not (null (find :uninitialized-this initial))))
             (handlers (slot-value attribute 'exceptions)))
        (labels ((compatible (locals stack flag frame target)
                   (destructuring-bind (expected-locals expected-stack expected-flag) frame
                     (unless (and (= (length stack) (length expected-stack))
                                  (or (not flag) expected-flag)
                                  (every (lambda (a b) (%v-assignable-p a b class)) locals expected-locals)
                                  (every (lambda (a b) (%v-assignable-p a b class)) stack expected-stack))
                       (verification-error "Incompatible type state at bytecode ~D" target))))
                 (edge (target locals stack flag)
                   (unless (< target n) (verification-error "Execution falls off end of method"))
                   (let ((frame (gethash target frames)) (old (gethash target states)))
                     (cond
                       (frame
                        (compatible locals stack flag frame target)
                        (unless old (setf (gethash target states) frame) (push target work)))
                       (old (compatible locals stack flag old target))
                       (t (setf (gethash target states) (list locals stack flag)) (push target work))))))
          ;; Frames start basic blocks, including otherwise unreachable blocks.
          (maphash (lambda (pc frame) (setf (gethash pc states) frame) (push pc work)) frames)
          (edge 0 initial nil initial-flag)
          (loop for insn across instructions when insn
                do (dolist (target (vi-targets insn))
                     (unless (gethash target frames)
                       (verification-error "Missing stack-map frame at branch target ~D" target)))
                   (let ((next (+ (vi-pc insn) (vi-size insn))))
                     (when (and (not (vi-fall-through-p insn)) (< next n) (not (gethash next frames)))
                       (verification-error "Missing stack-map frame after control transfer at ~D" next))))
          (loop for handler across (or handlers #())
                for type = (or (catch-type handler) "java/lang/Throwable")
                do (unless (gethash (handler-pc handler) frames)
                     (verification-error "Missing stack-map frame at exception handler"))
                   (unless (%v-assignable-p type "java/lang/Throwable" class)
                     (verification-error "Exception handler type ~A is not Throwable" type)))
          (loop while work for pc = (pop work) for insn = (aref instructions pc)
                do (destructuring-bind (locals stack flag) (gethash pc states)
                     (multiple-value-bind (out-locals out-stack out-flag exception-locals)
                         (%v-step class method insn locals stack flag)
                       (dolist (target (vi-targets insn)) (edge target out-locals out-stack out-flag))
                       (when (vi-fall-through-p insn)
                         (edge (+ pc (vi-size insn)) out-locals out-stack out-flag))
                       (loop for handler across (or handlers #())
                             when (<= (start-pc handler) pc (1- (end-pc handler)))
                               do (edge (handler-pc handler) exception-locals
                                        (list (or (catch-type handler) "java/lang/Throwable")) flag))))))))
    (setf (verified-p method) t))
  t)

(defvar *classes-being-verified* nil
  "The current thread's metadata verification chain, to diagnose loader recursion.")

(defun verify-class-bytecode (class)
  "Verify all methods before class initialization or the first JIT request."
  (unless (verified-p class)
    (when (member class *classes-being-verified*)
      (verification-error "Recursive verification of ~A" (name class)))
    (let ((*classes-being-verified* (cons class *classes-being-verified*)))
      (loop for method across (methods class)
            do (handler-case (verify-method-bytecode class method)
                 (bytecode-verification-error (condition)
                   (error 'bytecode-verification-error :java-kind (verification-java-kind condition)
                          :format-control "~A.~A~A: ~A"
                          :format-arguments (list (name class) (name method) (descriptor method) condition))))))
    (setf (verified-p class) t))
  t)

(defun %verify-class-for-java (class)
  "Verify a class while preserving Java-visible rejection exceptions."
  (handler-case (verify-class-bytecode class)
    (bytecode-verification-error (condition) (%throw-verification-error condition))))

(defun %v-check-pool (class)
  "Check symbolic constant-pool references without loading referenced classes."
  (let ((pool (constant-pool class))
        (bootstraps (gethash "BootstrapMethods" (attributes class))))
    (loop for index from 1 below (1- (length pool)) for entry = (aref pool index)
          do (typecase entry
               (null (unless (typep (aref pool (1- index)) '(or constant-long constant-double))
                       (class-format-error "Unexpected constant-pool hole at ~D" index)))
               (constant-class-reference
                (let ((name (%v-class-name pool index)))
                  (when (zerop (length name)) (class-format-error "Empty class name"))
                  (when (char= (char name 0) #\[) (%v-field-type name))))
               (constant-string-reference (%v-utf pool (slot-value entry 'index)))
               (constant-field-reference
                (multiple-value-bind (owner name descriptor) (%v-member pool index 'constant-field-reference)
                  (declare (ignore owner name)) (%v-field-type descriptor)))
               (constant-method-reference
                (multiple-value-bind (owner name descriptor) (%v-member pool index 'constant-method-reference)
                  (declare (ignore owner))
                  (multiple-value-bind (parameters result) (%v-method-types descriptor)
                    (declare (ignore parameters))
                    (when (and (string= name "<init>") (not (eql result :void)))
                      (verification-error "Constructor reference has non-void return")))))
               (constant-method-type (%v-method-types (%v-utf pool (slot-value entry 'descriptor-index))))
               ((or constant-invoke-dynamic constant-dynamic)
                (unless (< (slot-value entry 'bootstrap-method-attr-index) (length bootstraps))
                  (class-format-error "Invalid bootstrap method index"))
                (%v-dynamic-type pool entry (typep entry 'constant-invoke-dynamic)))
               (constant-method-handle
                (let ((kind (slot-value entry 'reference-kind))
                      (target (slot-value entry 'reference-index)))
                  (unless (<= 1 kind 9) (class-format-error "Invalid method handle reference kind"))
                  (if (<= kind 4) (%v-cp pool target 'constant-field-reference)
                      (multiple-value-bind (owner name descriptor)
                          (%v-member pool target
                                     (cond ((= kind 9) 'constant-interface-method-reference)
                                           ((or (= kind 5) (= kind 8) (< (major-version class) 52))
                                            '(and constant-method-reference (not constant-interface-method-reference)))
                                           (t 'constant-method-reference)))
                        (declare (ignore owner descriptor))
                        (unless (if (= kind 8) (string= name "<init>")
                                    (not (member name '("<init>" "<clinit>") :test #'string=)))
                          (class-format-error "Invalid method handle special method name"))))))
               ((or constant-module-reference constant-package-reference)
                (%v-utf pool (slot-value entry 'name-index)))))
    (dolist (bootstrap bootstraps)
      (%v-cp pool (slot-value bootstrap 'method-ref) 'constant-method-handle)
      (dolist (index (slot-value bootstrap 'method-args))
        (%v-cp pool index '(or constant-int constant-float constant-long constant-double
                              constant-string-reference constant-class-reference
                              constant-method-type constant-method-handle constant-dynamic)))))
  t)
