load_lib dg.exp
load_lib openldk.exp

dg-init

set dg-do-what-default run

set testargs ""
set testname ""

proc openldk_load { classfile } {

    global testargs testname mauve_base_classpath
    # Most of a run is JIT compilation; leave room for a loaded machine.
    set timeout 60
    verbose "load $classfile"
    set classname [string map {".class" ""} $classfile]
    set result [local_exec "../openldk mauve.openldkHarness $testargs" "" "" $timeout]
    verbose "result = $result"
    set status [lindex $result 0]
    set output [lindex $result 1]

    # Check if the test is in the expected failures file
    if {[is_expected_failure $testname]} {
        if { $status == 0 } {
            # Test passed but was expected to fail (xpass)
            return [list "xpass" $output]
        } else {
            # Test failed as expected (xfail)
            return [list "xfail" $output]
        }
    } else {
        if { $status == 0 } {
            # Test passed as expected (pass)
            return [list "pass" $output]
        } else {
            # Test failed unexpectedly (fail)
            return [list "fail" $output]
        }
    }
}

proc openldk-dg-test { prog do_what extra_tool_flags } {

    global testargs testname mauve_base_classpath
    set timeout 5

    verbose "prog $prog" 2
    verbose "do_what $do_what" 2
    verbose "extra_tool_flags $extra_tool_flags" 2

    # Run the javac command
    set JAVA_HOME [getenv "JAVA_HOME"]
    set classname [file rootname $prog]
    set classdir [file normalize "../.cache/mauve-tests/[string map {/ __} $classname]"]
    file delete -force $classdir
    file mkdir $classdir
    setenv "LDK_CLASSPATH" "$classdir:$mauve_base_classpath"
    setenv "CLASSPATH" "$classdir:$mauve_base_classpath"
    set status [local_exec "[openldk_javac] -d $classdir -sourcepath mauve $prog" "" "" $timeout]

    verbose "STATUS = $status"

    set classname [string map {".java" ""} $prog]

    set testargs [string map {"/" "."} [string map {"mauve/" ""} $classname]]

    return [list "" "[file join $classdir [string range $classname 6 end]].class"]
}

# Use find to locate all .java files under the specified directory
# and grep to filter those that contain "implements Testlet"
set tlist [exec find mauve/gnu/testlet/java -name "*.java" -type f | xargs grep -l "implements Testlet"]

# Convert the result into a Tcl list
set tlist [split $tlist "\n"]

# Optionally, sort the list if needed
set tlist [lsort $tlist]

set harness_dir [file normalize "../.cache/mauve-harness"]
file mkdir $harness_dir
set ldkcp [getenv "LDK_CLASSPATH"]
set mauve_base_classpath "$harness_dir:$ldkcp:.:./mauve"
setenv "LDK_CLASSPATH" $mauve_base_classpath
setenv "CLASSPATH" $mauve_base_classpath

set JAVA_HOME [getenv "JAVA_HOME"]
# Compile explicitly with the generated config: TestHarness inlines its
# constants. Keep generated bytecode outside the tracked legacy .class files.
set bootstrap [local_exec "[openldk_javac] -d $harness_dir -sourcepath mauve mauve/gnu/testlet/config.java mauve/gnu/testlet/TestHarness.java mauve/openldkHarness.java" "" "" "30"]
if {[lindex $bootstrap 0] != 0} {
    error "Mauve harness compilation failed: [lindex $bootstrap 1]"
}

foreach test $tlist {

    set selection [getenv "MAUVE_TEST_GLOB"]
    if {$selection != "" && ![string match $selection $test]} { continue }
    set reason [unsupported_test_reason $test]
    if {$reason != ""} {
        if {[lindex $reason 0] == "reference-timeout"} {
            unresolved "$test ([lindex $reason 1])"
        } else {
            unsupported "$test ([lindex $reason 1])"
        }
        continue
    }
    verbose "Testing $test"
    set testname "$test"
		dg-test $test "" ""

}

dg-finish
