# Jikes contains independently named mains, helper-only sources, intentional
# nonzero exits, and golden files produced by much older Java implementations.
# Use isolated compilation and the JDK 25 reference instead of reusing Test.class
# or treating every output mismatch as XFAIL.
load_lib openldk.exp

set test_files [lsort [glob -nocomplain -- jikestst/derek/ok/exec/*.e jikestst/hpj/ok/exec/*.e]]
foreach test_file $test_files {
    set result [local_exec "python3 audit-failures.py --suite jikestst --case $test_file --jobs 1 --fresh --output ../.cache/jikes" "" "" 300]
    set output [lindex $result 1]
    verbose $output
    if {[lindex $result 0] != 0 || ![regexp {1/1 ([a-z-]+): } $output -> category]} {
        unresolved "$test_file (audit runner failed)"
    } elseif {$category == "stale-pass" || $category == "stale-golden"} {
        pass $test_file
    } elseif {$category == "non-executable-fixture"} {
        unsupported "$test_file (helper source has no executable main)"
    } elseif {$category == "compile-rejected"} {
        unsupported "$test_file (JDK 25 rejects the source; see ../.cache/jikes)"
    } elseif {$category == "reference-failure"} {
        unsupported "$test_file (fails on JDK 25 too; see ../.cache/jikes)"
    } elseif {$category == "reference-timeout"} {
        unresolved "$test_file (JDK 25 reference timed out)"
    } elseif {[is_expected_failure $test_file]} {
        xfail $test_file
    } else {
        fail $test_file
    }
}
