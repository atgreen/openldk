load_lib dg.exp
load_lib openldk.exp

dg-init

set dg-do-what-default run

set testargs ""
set testname ""

proc openldk_load { classfile } {
    global testargs

    # Most of a run is JIT compilation; leave room for a loaded machine.
    set timeout 60
    verbose "load $classfile"
    # Isolate to this suite's own directory; do not accumulate onto the
    # inherited path (see gcj/gcj.exp for the cross-suite class-shadowing this
    # avoids).
    setenv "LDK_CLASSPATH" ".:./df"
    # These fixtures declare default-package classes. Their directory is a
    # classpath entry, rather than part of the class's binary name.
    set classname [file rootname [file tail $classfile]]
    set result [local_exec "../openldk $classname $testargs" "" "" $timeout]
    verbose "result = $result"
    set status [lindex $result 0]
    set output [lindex $result 1]
    set reference [local_exec "[getenv JAVA_HOME]/bin/java -cp .:./df $classname $testargs" "" "" $timeout]
    set reference_status [lindex $reference 0]
    set reference_output [lindex $reference 1]
    if { $reference_status != 0 } {
        set status 1
        append output "\nJDK 25 reference failed: $reference_output"
    } elseif { $status == 0 && [string trim [string map {"\r\n" "\n"} $output]] ne [string trim [string map {"\r\n" "\n"} $reference_output]] } {
        set status 1
        append output "\nJDK 25 reference output: $reference_output"
    }
    verbose "STATUS = $status"

    # Check if the test is in the expected failures file
    if {[is_expected_failure $classname]} {
        if { $status == 0 } {
            return [list "xpass" $output]
        } else {
            return [list "xfail" $output]
        }
    } else {
        if { $status == 0 } {
            return [list "pass" $output]
        } else {
            return [list "fail" $output]
        }
    }
}

proc openldk-dg-test { prog do_what extra_tool_flags } {
    global testargs
    set timeout 5

    verbose "prog $prog" 2
    verbose "do_what $do_what" 2
    verbose "extra_tool_flags $extra_tool_flags" 2

    set JAVA_HOME [getenv "JAVA_HOME"]
    set status [local_exec "[openldk_javac] $prog" "" "" $timeout]
    set classname [string map {".java" ""} $prog]
    set testargs ""

    return [list "" "$classname.class"]
}

set tlist [lsort [glob -nocomplain -- df/*.java]]

foreach test $tlist {
    global testname
    verbose "Testing $test"
    set testname "$test"
    dg-test $test "" ""
}

dg-finish

